注 待办事项管理器

{{
待办列表 = []

def 添加待办(事项):
    待办列表.append(事项)
    print(f"已添加：{事项}")

def 显示待办():
    if len(待办列表) == 0:
        print("待办列表为空")
    else:
        print("待办列表：")
        for i, item in enumerate(待办列表):
            print(f"{i}. {item}")

添加待办("学习言语言")
添加待办("完成项目")
添加待办("写文档")
显示待办()
print(f"待办数量：{len(待办列表)}")
}}。