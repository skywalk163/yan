-- ============================================
-- 言语言基础示例
-- ============================================

-- 算术运算
印10加5。        -- 15
印10减5。        -- 5
印10乘5。        -- 50
印10除5。        -- 2.0

-- 管道操作：数据流动
10加5，乘2，印。  -- (10+5)*2 = 30

-- 列表操作
印列1 2 3。      -- [1, 2, 3]
印范围5。        -- [1, 2, 3, 4, 5]

-- 高阶函数
列1 2 3，皆乘2，印。        -- [2, 4, 6]
列1 2 3 4 5，只大2，印。    -- [3, 4, 5]
列1 2 3，归加0，印。        -- 6

-- ============================================
-- 双轨制：数学表达式
-- ============================================

定x=$(1 + 2 * 3)。
印x。            -- 7

定半径=5。
定面积=$(3.14159 * 半径 * 半径)。
印面积。         -- 78.53975

-- ============================================
-- 双轨制：Python 代码块
-- ============================================

-- 单行 Python
定nums={{[x*x for x in range(1, 6)]}}。
印nums。         -- [1, 4, 9, 16, 25]

-- 多行 Python（最后一行作为返回值）
定阶乘={{
def fact(n):
    return 1 if n <= 1 else n * fact(n-1)
fact
}}。
印阶乘5。        -- 120

-- ============================================
-- 函数定义
-- ============================================

-- 中文函数
定平方=函x乘x x。
印平方5。        -- 25

-- 混合：中文函数名 + 数学表达式
定距离=函a b $(abs(a - b))。
印距离3 7。      -- 4

-- ============================================
-- 条件语句
-- ============================================

印若5大3则"大"否则"小"。    -- 大
印若$(10 > 5)则真否则假。   -- True
