-- 简单计算器（已修复，使用默认值）

定 计算 = 函 表达式
  {{
import re
tokens = re.findall(r'(\d+\.?\d*|[+\-*/])', 表达式)
result = float(tokens[0])
for i in range(1, len(tokens), 2):
    op = tokens[i]
    num = float(tokens[i+1])
    if op == '+':
        result += num
    elif op == '-':
        result -= num
    elif op == '*':
        result *= num
    elif op == '/':
        result /= num
result
}}。

印 "简单计算器"。

-- 使用默认值，不需要用户输入
定 输入 = "1+2*3"。
印 "输入表达式：" 输入。
定 结果 = 计算 输入。
印 "结果：" 连 结果。

-- 更多测试
印 ""。
印 "更多测试："。
印 "10-5 = " 连 计算 "10-5"。
印 "4*6 = " 连 计算 "4*6"。
印 "20/4 = " 连 计算 "20/4"。
