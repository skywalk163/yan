-- 简单计算器（已修复，使用默认值）

定义 计算 = 函数 表达式
  {{
import re
tokens = re.findall(r'(\d+\.?\d*|[+\-*/])', 表达式)
result = float(tokens[0])
for i in range(1, len(tokens), 2):
    op = tokens[i]
    num = float(tokens[i+1])
    if op == '+':
        result += num
    elif op == '-':
        result -= num
    elif op == '*':
        result *= num
    elif op == '/':
        result /= num
result
}}。

输出 "简单计算器"。

-- 使用默认值，不需要用户输入
定义 输入 = "1+2*3"。
输出 "输入表达式：" 输入。
定义 结果 = 计算 输入。
输出 "结果：" 连接 结果。

-- 更多测试
输出 ""。
输出 "更多测试："。
输出 "10-5 = " 连接 计算 "10-5"。
输出 "4*6 = " 连接 计算 "4*6"。
输出 "20/4 = " 连接 计算 "20/4"。
