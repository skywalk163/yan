-- 数据处理示例
-- 展示言语言的列表处理能力

输出 "=== 列表数据处理 ==="。
输出 ""。

-- 创建数字列表
定义 数字 = 列表 85 72 91 68 95 55 78 63。
输出 "原始数字："。
输出 数字。
输出 ""。

-- 计算总和
定义 总和 = 0。
定义 i = 0。
当时 小于 i 长度 数字：
  定义 当前 = 取 数字 i。
  定义 总和 = 加 总和 当前。
  定义 i = 加 i 1。
。
输出 连接 "总和: " 总和。

-- 计算平均
定义 平均 = 除 总和 长度 数字。
输出 连接 "平均: " 平均。
输出 ""。

-- 找出最大值
定义 最大于 = 0。
定义 i = 0。
当时 小于 i 长度 数字：
  定义 当前 = 取 数字 i。
  如果 大于 当前 最大：
    定义 最大于 = 当前。
  。
  定义 i = 加 i 1。
。
输出 连接 "最大值: " 最大。

-- 找出最小值
定义 最小于 = 100。
定义 i = 0。
当时 小于 i 长度 数字：
  定义 当前 = 取 数字 i。
  如果 小于 当前 最小：
    定义 最小于 = 当前。
  。
  定义 i = 加 i 1。
。
输出 连接 "最小值: " 最小。
输出 ""。

-- 字符串操作
输出 "=== 字符串处理 ==="。
输出 ""。

定义 名字 = "言语言"。
输出 连接 "你好，" 名字 "！"。
输出 连接 "名字长度: " 长度 名字。

-- 字符串连接
定义 句子 = 连接 "这是" "一个" "测试"。
输出 句子。
输出 ""。

-- 使用表达式求值
输出 "=== 表达式求值 ==="。
输出 ""。

输出 连接 "3 + 4 * 2 = " 求值 "3 + 4 * 2"。
输出 连接 "(3 + 4) * 2 = " 求值 "(3 + 4) * 2"。
输出 连接 "10 - 5 / 2 = " 求值 "10 - 5 / 2"。

输出 ""。
输出 "=== 完成 ==="。
