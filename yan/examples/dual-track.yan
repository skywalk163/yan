-- 双轨制示例

-- 一、数学表达式 $()

定a=$(1 + 2 * 3)。
印a。

定r=5。
定area=$(3.14159 * r * r)。
印area。

-- 二、Python 代码块 {{}} 

定nums={{[x for x in range(2, 11, 2)]}}。
印nums。

定fib={{
def fib(n):
    a, b = 0, 1
    for _ in range(n):
        a, b = b, a + b
    return a
fib
}}。
印fib 10。

-- 三、混合使用

定sum2=函a b $(a*a + b*b)。
印sum2 3 4。

定score=75。
印若$(score >= 60)则"及格"否则"不及格"。
