-- 猜数字游戏（已修复，使用默认值）

{{
import random

print("猜数字游戏！")

秘密数字 = random.randint(1, 100)
猜测次数 = 0

print(f"我想了一个1-100之间的数字（实际上是 {秘密数字}）。")

# 使用预设的猜测序列，模拟游戏过程
猜测列表 = [50, 75, 87, 93, 96, 98, 99, 秘密数字]

for 猜测 in 猜测列表:
    猜测次数 += 1
    print(f"\n请输入你的猜测：{猜测}")
    
    if 猜测 < 秘密数字:
        print("太小了！")
    elif 猜测 > 秘密数字:
        print("太大了！")
    else:
        print(f"恭喜！你猜中了！用了 {猜测次数} 次。")
        break
}}
