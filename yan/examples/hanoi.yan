-- ============================================
-- 汉诺塔问题 - 言语言示例
-- ============================================
--
-- 问题：将 n 个圆盘从柱子 A 移到柱子 C
-- 规则：每次只能移动一个圆盘，大盘不能放在小盘上面
-- 解法：递归
--
-- ============================================

-- 完整的汉诺塔实现（使用 Python 代码块）
定汉诺塔={{
def hanoi(n, source, target, auxiliary):
    if n == 1:
        print(f"移动盘子 1: {source} -> {target}")
        return
    hanoi(n - 1, source, auxiliary, target)
    print(f"移动盘子 {n}: {source} -> {target}")
    hanoi(n - 1, auxiliary, target, source)
hanoi
}}。

-- 测试：3 个盘子
印"=== 汉诺塔 - 3 个盘子 ==="。
汉诺塔3 "A" "C" "B"。

-- 计算移动次数：2^n - 1
定移动次数=函n {{2**n - 1}}。

印""。
印"=== 移动次数统计 ==="。
印"n=3: "。
印移动次数3。
印"n=5: "。
印移动次数5。
印"n=10: "。
印移动次数10。
印"n=20: "。
印移动次数20。
