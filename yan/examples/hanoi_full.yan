-- 汉诺塔问题演示（完整递归版本，已修复）

{{
print("=== 汉诺塔问题演示 ===")

def 汉诺塔(盘子数, 源, 目标, 辅助):
    if 盘子数 > 0:
        汉诺塔(盘子数 - 1, 源, 辅助, 目标)
        print(f"移动盘子{盘子数}从{源}到{目标}")
        汉诺塔(盘子数 - 1, 辅助, 目标, 源)

print("\n移动 1 个盘子：")
汉诺塔(1, "A", "C", "B")

print("\n移动 2 个盘子：")
汉诺塔(2, "A", "C", "B")

print("\n移动 3 个盘子：")
汉诺塔(3, "A", "C", "B")
}}
