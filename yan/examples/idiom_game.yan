-- 成语接龙游戏
-- 言语言实现

输出 "=== 成语接龙游戏 ==="。
输出 ""。
输出 "规则：输入四字成语，AI会接着你的最后一个字继续"。
输出 "输入 '退出' 结束游戏"。
输出 ""。

-- 从文件加载成语库
定义 成语文本 = {{ __import__('pathlib').Path('examples/idioms.txt').read_text(encoding='utf-8') }}。
定义 成语行列表 = {{ 成语文本.splitlines() }}。
定义 成语库 = {{ [行.strip() for 行 in 成语行列表 if 行.strip() and not 行.strip().startswith('--')] }}。

-- 游戏状态
定义 已用 = 列。
定义 尾 = ""。
定义 玩 = 真。

输出 "请输入第一个成语："。

当时 玩：
  定义 你 = 读行
  
  如果 等于 你 "quit"：
    输出 "游戏结束！"
    定义 玩 = 假
    继续
  
  如果 等于 你 "exit"：
    输出 "游戏结束！"
    定义 玩 = 假
    继续
  
  如果 等于 你 "help"：
    输出 ""
    输出 "=== 帮助 ==="
    输出 "  输入四字成语接龙"
    输出 "  输入 'quit' 或 'exit' 退出"
    输出 "  输入 'help' 显示帮助"
    输出 "  输入 '库' 查看所有可用成语"
    输出 ""
    继续
  
  如果 等于 你 "库"：
    输出 ""
    输出 "=== 可用成语库 ==="
    遍历 c 于 成语库：
      输出 连接 "  " c
    输出 ""
    继续
  
  如果 等于 你 "帮"：
    如果 空 尾：
      输出 "还没有开始接龙，请先输入一个成语！"
      继续
    定义 可选 = 列
    遍历 y 于 成语库：
      如果 非 包含 已用 y：
        定义 z = 截取 y 0 1
        如果 等于 z 尾：
          添加 可选 y
    如果 空 可选：
      输出 "没有可用的提示了！"
    如果 非 空 可选：
      输出 ""
      输出 "=== 提示 ==="
      输出 连接 "可以接 \"" 尾 "\" 开头的成语有："
      遍历 h 于 可选：
        输出 连接 "  " h
      输出 ""
    继续
  
  如果 等于 你 "退出"：
    输出 "游戏结束！"
    定义 玩 = 假
    继续
  
  如果 不等于 长度 你 4：
    输出 "请输入四字成语！"
    继续
  
  如果 非 包含 成语库 你：
    输出 连接 "\"" 你 "\" 不在库中！"
    继续
  
  如果 包含 已用 你：
    输出 连接 "\"" 你 "\" 已用过！"
    继续
  
  如果 非 空 尾：
    定义 x = 截取 你 0 1
    如果 非 等于 x 尾：
      输出 连接 "需要以 \"" 尾 "\" 开头！"
      继续
  
  添加 已用 你
  定义 尾 = 截取 你 3 4
  输出 连接 "你：" 你 连接 "（" 尾 "）"
  
  输出 "AI思考中..."
  {{ __import__('time').sleep(0.5) }}
  
  定义 选 = 列
  遍历 y 于 成语库：
    如果 非 包含 已用 y：
      定义 z = 截取 y 0 1
      如果 等于 z 尾：
        添加 选 y
  
  如果 空 选：
    输出 "AI接不上了！你赢了！"
    定义 玩 = 假
    继续
  
  定义 选长度 = 长度 选
  定义 i = {{ __import__('random').randint(0, 选长度 - 1) }}
  定义 r = 取 选 i
  
  添加 已用 r
  定义 尾 = 截取 r 3 4
  输出 连接 "AI：" r 连接 "（" 尾 "）"
  
。。

输出 ""。
输出 "=== 游戏结束 ==="。
输出 连接 "共使用了 " 连接 长度 已用 " 个成语"。
