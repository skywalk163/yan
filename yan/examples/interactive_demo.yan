-- 交互式程序示例
-- 展示言语言的输入输出功能

输出 "=== 交互式程序列 ==="。
输出 ""。
输出 "欢迎使用言语言交互式示例！"。
输出 ""。

-- 1. 简单的输入输出
输出 "--- 1. 简单输入输出 ---"。
输出 "请告诉我你的名字："。
定义 名字 = 读行。
输出 连接 "你好，" 名字 "！很高兴认识你！"。
输出 ""。

-- 2. 数字输入计算
输出 "--- 2. 数字计算 ---"。
输出 "现在，我们来做一些计算。"。
输出 "请输入第一个数字："。
定义 输入1 = 读行。
输出 "请输入第二个数字："。
定义 输入2 = 读行。

-- 使用Python嵌入转换字符串为数字
定义 数1 = {{ int(输入1.strip()) if 输入1.strip().isdigit() or (输入1.strip().startswith('-') and 输入1.strip()[1:].isdigit()) else 0 }}。
定义 数2 = {{ int(输入2.strip()) if 输入2.strip().isdigit() or (输入2.strip().startswith('-') and 输入2.strip()[1:].isdigit()) else 0 }}。

输出 连接 "数1 = " 数1。
输出 连接 "数2 = " 数2。

定义 和 = 加 数1 数2。
定义 差 = 减 数1 数2。
定义 积 = 乘 数1 数2。

输出 连接 数1 " + " 数2 " = " 和。
输出 连接 数1 " - " 数2 " = " 差。
输出 连接 数1 " * " 数2 " = " 积。
输出 ""。

-- 3. 猜数字游戏
输出 "--- 3. 猜数字游戏 ---"。
输出 "让我们玩个猜数字游戏！"。
输出 "我想一个 1 到 10 之间的数，你来猜。"。
输出 ""。

定义 答案 = {{ __import__('random').randint(1, 10) }}。
输出 连接 "（答案是: " 答案 "）"。
定义 猜次数 = 0。
定义 猜中 = 假。

当时 非 猜中：
  输出 "请猜一个数字："
  定义 猜输入 = 读行
  定义 猜 = {{ int(猜输入.strip()) if 猜输入.strip().isdigit() else 0 }}
  定义 猜次数 = 加 猜次数 1
  
  如果 等于 猜 答案：
    定义 猜中 = 真
    输出 连接 "恭喜！你猜对了！用了 " 猜次数 " 次。"
  否则：
    如果 小于 猜 答案：
      输出 "太小了，再大一点！"
    否则：
      输出 "太大了，再小一点！"

输出 ""。

-- 4. 简单的菜单系统
输出 "--- 4. 菜单系统 ---"。
定义 继续 = 真。

当时 继续：
  输出 ""
  输出 "请选择："
  输出 "  1. 问候"
  输出 "  2. 计算"
  输出 "  3. 退出"
  输出 ""
  输出 "请输入选项："
  
  定义 选项 = 读行
  
  如果 等于 选项 "1"：
    输出 "你好！今天过得怎么样？"
  否则：
    如果 等于 选项 "2"：
      输出 "请输入第一个数："
      定义 a = 读行
      输出 "请输入第二个数："
      定义 b = 读行
      定义 n1 = {{ int(a.strip()) if a.strip().isdigit() else 0 }}
      定义 n2 = {{ int(b.strip()) if b.strip().isdigit() else 0 }}
      输出 连接 n1 " + " n2 " = " 加 n1 n2
    否则：
      如果 等于 选项 "3"：
        输出 "再见！感谢使用！"
        定义 继续 = 假
      否则：
        输出 "无效选项，请重新选择。"

输出 ""。
输出 "=== 程序结束 ==="。