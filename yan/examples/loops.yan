-- 循环示例（已简化为Python嵌入语法）

{{
print("=== 循环示例 ===")

# 遍历循环：打印1到5
print("\n遍历循环：")
for x in range(1, 6):
    print(x)

# 当循环：计算1+2+3+4
print("\n当循环：")
计数 = 0
总和 = 0
while 计数 < 5:
    总和 = 总和 + 计数
    计数 = 计数 + 1
print(总和)

# 遍历列表
print("\n遍历列表：")
水果 = ["苹果", "香蕉", "橙子"]
for item in 水果:
    print(item)

# 循环与条件结合
print("\n循环与条件结合：")
for x in range(10):
    if x % 2 == 0:
        print(x)

print("\n循环示例完成！")
}}
