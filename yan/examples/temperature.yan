注 温度转换器

{{
def 华氏转摄氏(华氏度):
    return (华氏度 - 32) * 5 / 9

def 摄氏转华氏(摄氏度):
    return 摄氏度 * 9 / 5 + 32

print("温度转换器")
print("1. 华氏转摄氏")
print("2. 摄氏转华氏")
选择 = input("请选择（1或2）：")

if 选择 == "1":
    华氏 = float(input("输入华氏度："))
    print(f"{华氏}°F = {华氏转摄氏(华氏)}°C")
elif 选择 == "2":
    摄氏 = float(input("输入摄氏度："))
    print(f"{摄氏}°C = {摄氏转华氏(摄氏)}°F")
else:
    print("无效选择")
}}。