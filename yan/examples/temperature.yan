-- 温度转换器（已修复，使用默认值）

{{
print("温度转换器")
print("1. 华氏转摄氏")
print("2. 摄氏转华氏")

# 使用预设值测试两种转换
选择 = "1"
print(f"\n请选择（1或2）：{选择}")

if 选择 == "1":
    华氏 = 100
    print(f"输入华氏度：{华氏}")
    摄氏 = (华氏 - 32) * 5 / 9
    print(f"{华氏}华氏度 = {摄氏:.2f}摄氏度")
elif 选择 == "2":
    摄氏 = 37
    print(f"输入摄氏度：{摄氏}")
    华氏 = 摄氏 * 9 / 5 + 32
    print(f"{摄氏}摄氏度 = {华氏:.2f}华氏度")

# 测试第二种转换
print("\n--- 额外测试 ---")
选择2 = "2"
print(f"\n请选择（1或2）：{选择2}")
摄氏2 = 25
print(f"输入摄氏度：{摄氏2}")
华氏2 = 摄氏2 * 9 / 5 + 32
print(f"{摄氏2}摄氏度 = {华氏2:.2f}华氏度")
}}
