-- 断言示例（已简化为Python嵌入语法）

{{
print("断言示例")

数据 = [1, 2, 3]

print("\n测试包含：")
if 2 in 数据:
    print("✓ 数据包含 2")
else:
    print("✗ 数据不包含 2")

print("\n测试长度：")
print(f"数据长度： {len(数据)}")
if len(数据) == 3:
    print("✓ 数据长度为 3")
else:
    print("✗ 数据长度不为 3")

print("\n测试比较：")
if 5 > 3:
    print("✓ 5 大于 3")
if 3 < 5:
    print("✓ 3 小于 5")
if 2 == 2:
    print("✓ 2 等于 2")

print("\n所有断言测试完成！")
}}
