-- 成语接龙游戏自动测试
-- 言语言实现

输出 "=== 成语接龙自动测试 ==="。
输出 ""。

-- 成语库（添加了意字开头的成语）
定义 库 = 列
  "一心一意" "意气风发" "意气相投" "意气飞扬" "意气用事"
  "意气轩昂" "意气自若" "意气洋洋" "意气凌云" "意气激昂"
  "意气昂扬" "意气消沉"
  "发愤图强" "发愤忘食" "发蒙振落" "发人深省" "发人深思"
  "发号施令" "发扬光大"
  "强词夺理" "强词夺正" "强不知以为知" "强将手下无弱兵"
  "强弩之末" "强中自有强中手"
  "理直气壮" "理屈词穷" "理所当然" "理不忘乱"
  "壮志凌云" "壮志未酬" "壮气凌云"
  "云开雾散" "云开见日" "云雾迷蒙" "云消雾散" "云蒸霞蔚"
  "开门见山" "开门延盗" "开门揖盗" "开山祖师" "开源节流"
  "山清水秀" "山明水秀" "山明水净" "山高水长" "山高水低"
  "秀外慧中" "秀出班行" "秀而不实" "秀色可餐" "秀外惠中"
  "中流砥柱" "中流击楫" "中流底柱" "中立不倚" "中道而废"
  "水落石出" "水涨船高" "水乳交融" "水深火热" "水泄不通"
  "出人头地" "出尔反尔" "出污泥而不染" "出奇制胜" "出生入死"

-- 预设测试输入序列
定义 测试输入 = 列表 "一心一意" "意气风发" "发愤图强" "强词夺理"。
定义 输入索引 = 0。

-- 游戏状态
定义 已用 = 列。
定义 尾 = ""。

-- 第一轮：第一个成语
输出 连接 "[第1轮] 输入：一心一意"。
定义 你 = "一心一意"。
添加 已用 你。
定义 尾 = 截取 你 3 4。
输出 连接 "你：" 你 连接 "（尾字：" 尾 "）"。

-- AI 选择
定义 选 = 列。
遍历 y 于 库：
  定义 z = 截取 y 0 1
  定义 已用过 = 包含 已用 y
  定义 匹配 = 且 非 已用过 等于 z 尾
  如果 匹配：
    添加 选 y

定义 选长度 = 长度 选。
定义 i = {{ __import__('random').randint(0, 选长度 - 1) }}。
定义 r = 取 选 i。

添加 已用 r。
定义 尾 = 截取 r 3 4。
输出 连接 "AI：" r 连接 "（尾字：" 尾 "）"。
输出 ""。

