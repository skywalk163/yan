-- 成语接龙完整自动测试
-- 模拟多轮游戏

输出 "=== 成语接龙完整测试 ==="。
输出 ""。

-- 成语库
定义 库 = 列
  "一心一意" "意气风发" "发愤图强" "强词夺理" "理直气壮"
  "壮志凌云" "云开雾散" "开门见山" "山清水秀" "秀外慧中"
  "中流砥柱" "水落石出" "出人头地"
。

-- 游戏状态
定义 已用 = 列。
定义 尾 = ""。
定义 回合 = 0。

输出 "开始游戏..."。
输出 ""。

-- 第一轮：玩家输入
定义 回合 = 加 回合 1。
输出 连接 "[第" 连接 回合 "轮] 玩家：一心一意"。
添加 已用 "一心一意"。
定义 尾 = 截取 "一心一意" 3 4。

-- AI 响应
定义 选 = 列。
遍历 y 于 库：
  如果 非 包含 已用 y：
    定义 z = 截取 y 0 1。
    如果 等于 z 尾：
      添加 选 y。
    。。  -- 结束内层若
  。。    -- 结束外层若
。。

如果 非 空 选：
  定义 r = 首 选。
  添加 已用 r。
  定义 尾 = 截取 r 3 4。
  输出 连接 "AI：" r 连接 "（" 尾 "）"。
。

输出 ""。

-- 第二轮：玩家输入
定义 回合 = 加 回合 1。
输出 连接 "[第" 连接 回合 "轮] 玩家：发愤图强"。

-- 验证是否可以接龙
定义 首字 = 截取 "发愤图强" 0 1。
如果 非 等于 首字 尾：
  输出 连接 "错误：需要以 \"" 尾 "\" 开头！"。
。。
如果 等于 首字 尾：
  添加 已用 "发愤图强"。
  定义 尾 = 截取 "发愤图强" 3 4。
  
  -- AI 响应
  定义 选 = 列。
  遍历 y 于 库：
    如果 非 包含 已用 y：
      定义 z = 截取 y 0 1。
      如果 等于 z 尾：
        添加 选 y。
      。。  -- 结束内层若
    。。    -- 结束外层若
  。。

  如果 非 空 选：
    定义 r = 首 选。
    添加 已用 r。
    定义 尾 = 截取 r 3 4。
    输出 连接 "AI：" r 连接 "（" 尾 "）"。
  。
  如果 空 选：
    输出 "AI 接不上了！"。
  。
。。

输出 ""。
输出 "=== 游戏结束 ==="。
输出 连接 "共进行了 " 连接 回合 " 回合"。
输出 连接 "使用了 " 连接 长度 已用 " 个成语"。
输出 ""。
输出 "使用的成语："。
遍历 c 于 已用：
  输出 连接 "  " c。
。
输出 ""。
输出 "=== 测试通过 ==="。
