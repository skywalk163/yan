-- 成语接龙自动测试
-- 验证核心功能

输出 "=== 成语接龙自动测试 ==="。
输出 ""。

-- 成语库
定义 库 = 列
  "一心一意" "意气风发" "发愤图强" "强词夺理" "理直气壮"
  "壮志凌云" "云开雾散" "开门见山" "山清水秀"
。

-- 测试1：验证成语在库中
输出 "测试1：验证成语在库中"。
定义 t1 = 包含 库 "一心一意"。
如果 t1：
  输出 "  通过：一心一意 在库中"。
。。
定义 t2 = 包含 库 "意气风发"。
如果 t2：
  输出 "  通过：意气风发 在库中"。
。。

-- 测试2：验证字符串截取
输出 "测试2：验证字符串截取"。
定义 s1 = 截取 "一心一意" 0 1。
输出 连接 "  \"一心一意\" 首字：" s1。
定义 s2 = 截取 "一心一意" 3 4。
输出 连接 "  \"一心一意\" 尾字：" s2。

-- 测试3：模拟接龙
输出 "测试3：模拟接龙"。
定义 已用 = 列。
添加 已用 "一心一意"。
定义 尾 = 截取 "一心一意" 3 4。
输出 连接 "  你：一心一意（尾字：" 连接 尾 "）"。

-- AI 选择
定义 选 = 列。
遍历 y 于 库：
  如果 非 包含 已用 y：
    定义 z = 截取 y 0 1。
    如果 等于 z 尾：
      添加 选 y。
    。。  -- 结束内层若
  。。    -- 结束外层若
。。      -- 结束遍历

输出 连接 "  可选数量：" 长度 选。

-- 显示可选成语
遍历 c 于 选：
  输出 连接 "    " c。
。。

输出 ""。
输出 "=== 测试完成 ==="。
