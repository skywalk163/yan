-- 测试交互逻辑（非交互模式）
输出 "=== 测试交互逻辑 ==="。

-- 模拟用户输入
定义 输入1 = "2"。
定义 输入2 = "3"。

-- 测试数字转换
输出 "--- 数字计算 ---"。
定义 数1 = {{ int(输入1.strip()) if 输入1.strip().isdigit() else 0 }}。
定义 数2 = {{ int(输入2.strip()) if 输入2.strip().isdigit() else 0 }}。

定义 和 = 加 数1 数2。
输出 连接 数1 " + " 数2 " = " 和。
输出 ""。

-- 测试猜数字游戏逻辑
输出 "--- 猜数字逻辑 ---"。
定义 答案 = 5。
定义 猜 = 5。

如果 等于 猜 答案：
  输出 "恭喜！你猜对了！"
否则：
  如果 小于 猜 答案：
    输出 "太小了，再大一点！"
  否则：
    输出 "太大了，再小一点！"

输出 ""。

-- 测试猜错的情况
定义 猜2 = 3。
输出 连接 "猜 " 猜2 "："。
如果 等于 猜2 答案：
  输出 "恭喜！你猜对了！"
否则：
  如果 小于 猜2 答案：
    输出 "太小了，再大一点！"
  否则：
    输出 "太大了，再小一点！"

输出 ""。

-- 测试菜单逻辑
输出 "--- 菜单逻辑 ---"。
定义 选项 = "1"。

如果 等于 选项 "1"：
  输出 "你好！今天过得怎么样？"
否则：
  如果 等于 选项 "2"：
    输出 "计算功能"
  否则：
    如果 等于 选项 "3"：
      输出 "退出"
    否则：
      输出 "无效选项"

输出 ""。

-- 测试无效选项
定义 选项2 = "4"。
输出 连接 "选项 " 选项2 "："。
如果 等于 选项2 "1"：
  输出 "你好！今天过得怎么样？"
否则：
  如果 等于 选项2 "2"：
    输出 "计算功能"
  否则：
    如果 等于 选项2 "3"：
      输出 "退出"
    否则：
      输出 "无效选项"

输出 ""。
输出 "=== 测试完成 ==="。