-- 测试数字转换
输出 "=== 测试数字转换 ==="。

定义 输入1 = "2"。
定义 输入2 = "3"。

输出 连接 "输入1: " 输入1。
输出 连接 "输入2: " 输入2。

-- 使用Python嵌入转换字符串为数字
定义 数1 = {{ int(输入1.strip()) if 输入1.strip().isdigit() else 0 }}。
定义 数2 = {{ int(输入2.strip()) if 输入2.strip().isdigit() else 0 }}。

输出 连接 "数1: " 数1。
输出 连接 "数2: " 数2。

定义 和 = 加 数1 数2。

输出 连接 数1 " + " 数2 " = " 和。