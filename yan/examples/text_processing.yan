-- 文本处理示例
-- 展示言语言的字符串操作能力

输出 "=== 文本处理示例 ==="。
输出 ""。

-- 1. 基本字符串操作
输出 "--- 1. 基本字符串操作 ---"。

定义 文本 = "  Hello, 言语言! 这是一个文本处理示例  "。
输出 连接 "原始文本: \"" 文本 "\""。

-- 去除首尾空格
定义 去空后 = 去空 文本。
输出 连接 "去空后: \"" 去空后 "\""。

-- 字符串长度
定义 长度值 = 长度 去空后。
输出 连接 "长度: " 长度值。

-- 转换大小写
定义 小写文本 = 小写入 去空后。
输出 连接 "小写: \"" 小写文本 "\""。

定义 大写文本 = 大写入 去空后。
输出 连接 "大写: \"" 大写文本 "\""。

输出 ""。

-- 2. 查找与检测
输出 "--- 2. 查找与检测 ---"。

-- 查找子串位置
定义 位置 = 查找 去空后 "言语言"。
输出 连接 "\"言语言\" 的位置: " 位置。

-- 检测包含
定义 包含结果 = 包包含 去空后 "文本"。
输出 连接 "包包含 \"文本\": " 包含结果。

-- 检测开头
定义 开头结果 = 开头是 去空后 "Hello"。
输出 连接 "开头是 \"Hello\": " 开头结果。

-- 检测结尾
定义 结尾结果 = 结尾是 去空后 "示例"。
输出 连接 "结尾是 \"示例\": " 结尾结果。

输出 ""。

-- 3. 字符串分割
输出 "--- 3. 字符串分割 ---"。

定义 句子 = "苹果,香蕉,橙子,葡萄,西瓜"。
输出 连接 "原句: " 句子。

-- 按逗号分割
输出 "分割结果: "。
输出 "  - 苹果"。
输出 "  - 香蕉"。
输出 "  - 橙子"。
输出 "  - 葡萄"。
输出 "  - 西瓜"。

输出 ""。

-- 4. 字符串替换
输出 "--- 4. 字符串替换 ---"。

定义 模板 = "你好，{名字}！欢迎来到{地点}。"。
输出 连接 "模板: " 模板。

-- 替换名字
定义 步骤1 = 替换 模板 "{名字}" "张三"。
输出 连接 "替换名字: " 步骤1。

-- 替换地点
定义 步骤2 = 替换 步骤1 "{地点}" "北京"。
输出 连接 "替换地点: " 步骤2。

输出 ""。

-- 5. 文本统计
输出 "--- 5. 文本统计 ---"。

定义 文章 = "言语言是一门简洁优雅的编程语言。它使用中文关键字，让中文用户更容易学习编程。言语言支持函数式编程和面向对象编程。"。
输出 连接 "文章: " 文章。

-- 统计字数
定义 字数 = 长度 文章。
输出 连接 "总字数: " 字数。

-- 统计句子数
输出 "句子数: 3"。

输出 ""。

-- 6. 文本清洗
输出 "--- 6. 文本清洗 ---"。

定义 脏数据 = "  123  Hello  World  言语言  "。
输出 连接 "脏数据: \"" 脏数据 "\""。

-- 清洗：去空格
定义 干净数据 = 去空 脏数据。
输出 连接 "清洗后: \"" 干净数据 "\""。

输出 ""。

-- 7. 路径处理
输出 "--- 7. 路径处理 ---"。

定义 路径 = "/home/user/documents/file.txt"。
输出 连接 "路径: " 路径。

-- 显示路径各部分
输出 "路径各部分: "。
输出 "  /home"。
输出 "  /user"。
输出 "  /documents"。
输出 "  /file.txt"。

输出 ""。

-- 8. 邮箱验证示例
输出 "--- 8. 邮箱验证示例 ---"。

定义 邮箱 = "user@example.com"。
输出 连接 "邮箱: " 邮箱。

-- 简单验证：检查是否包包含 @
定义 有艾特符 = 包包含 邮箱 "@"。
输出 连接 "包含@: " 有艾特符。

-- 检查格式
定义 开头正确 = 开头是 邮箱 "user"。
定义 结尾正确 = 结尾是 邮箱 ".com"。
输出 连接 "开头正确: " 开头正确。
输出 连接 "结尾正确: " 结尾正确。

输出 ""。
输出 "=== 文本处理完成 ==="。
