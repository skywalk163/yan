-- 图灵机示例（已简化为Python嵌入语法）

{{
print("=== 图灵机示例 ===")

# 简单的图灵机模拟 - 二进制递增
print("\n二进制递增示例: 1011 (13) -> 1100 (14)")
print("\n=== 简化版示例：")

# 简化的二进制加1函数
def binary_increment(binary_str):
    binary_list = list(binary_str)
    i = len(binary_list) - 1
    carry = 1
    while i >= 0 and carry:
        bit = binary_list[i]
        if bit == '0':
            binary_list[i] = '1'
            carry = 0
        elif bit == '1':
            binary_list[i] = '0'
            carry = 1
        i -= 1
    if carry:
        binary_list.insert(0, '1')
    return ''.join(binary_list)

# 测试
test_cases = ['1011', '11', '1', '100']
for case in test_cases:
    print(f"{case} -> {binary_increment(case)}")

print("\n图灵机示例完成！")
}}
