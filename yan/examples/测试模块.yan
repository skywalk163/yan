-- 测试模块导入（已简化为Python嵌入语法）

{{
print("=== 模块导入示例 ===")

# 模拟模块导入功能
print("注：当前使用Python嵌入语法演示模块功能")

# 模拟从模块导入的函数
def 平方(x):
    return x * x

def 立方(x):
    return x * x * x

def 问候(name):
    return f"你好，{name}！"

# 使用导入的函数
结果1 = 平方(5)
结果2 = 立方(3)
问候语 = 问候("张三")

print(f"平方 5 = {结果1}")
print(f"立方 3 = {结果2}")
print(问候语)
}}
