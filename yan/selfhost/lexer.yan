-- 词法分析器模块（纯言语言实现）

-- Token类型常量
定TOKEN_EOF=0。
定TOKEN_WORD=1。
定TOKEN_NUM=2。
定TOKEN_STR=3。
定TOKEN_COMMA=4。
定TOKEN_DOT=5。
定TOKEN_COLON=6。
定TOKEN_EQUALS=7。
定TOKEN_SEMI=8。
定TOKEN_QUOTE=9。
定TOKEN_PYTHON=10。
定TOKEN_KEYWORD=11。
定TOKEN_VERB=12。

-- 关键字列表
定关键字=列"定" "函" "若" "则" "否则" "当" "真" "假" "空" "无"。

-- 动词列表
定动词=列"加" "减" "乘" "除" "等于" "大于" "小于" "列" "印" "取" "入" "长" "连"。

-- 特殊字符判断
定是特殊字符=函字符：
  或字符等于"，"或字符等于"。"或字符等于"："或字符等于"="或字符等于"；"或字符等于"’"。
．

-- 获取特殊字符类型
定取特殊字符类型=函字符：
  当字符等于"，"：返回TOKEN_COMMA。。当字符等于"。"：返回TOKEN_DOT。。当字符等于"："：返回TOKEN_COLON。。当字符等于"="：返回TOKEN_EQUALS。。当字符等于"；"：返回TOKEN_SEMI。。当字符等于"’"：返回TOKEN_QUOTE。。返回TOKEN_WORD。
．

-- 判断是否是关键字
定是关键字=函词：
  定i=0。
  当i小于长关键字：
    当取关键字i等于词：返回真。。i=加i1。。返回假。
．

-- 判断是否是动词
定是动词=函词：
  定i=0。
  当i小于长动词：
    当取动词i等于词：返回真。。i=加i1。。返回假。
．

-- 获取字符类型
定取字符类型=函字符：
  定码=入字符0。
  当是数字字符：返回"数字"。。当是字母字符：返回"字母"。。当是中文字符：返回"中文"。。当是空白字符：返回"空白"。。返回"其他"。
．

-- 判断字符类型
定是数字字符=函字符：
  定码=入字符0。
  或码等于48或码等于49或码等于50或码等于51或码等于52或码等于53或码等于54或码等于55或码等于56或码等于57。
．

定是字母字符=函字符：
  定码=入字符0。
  或且码大于等于65码小于等于90且码大于等于97码小于等于122。
．

定是中文字符=函字符：
  定码=入字符0。
  且码大于2047码小于等于65535。
．

定是空白字符=函字符：
  定码=入字符0。
  或码等于32或码等于9或码等于10或码等于13。
．

-- 跳过空白字符
定跳过空白=函源码当前位置：
  定i=位置。
  当真：
    当i大于等于长源码：返回位置。i=加i1。。定c=入源码i。当c等于""：返回位置。。当是空白字符：i=加i1。。返回i。
．

-- 扫描Python代码块
定扫描Python=函源码起始位置行号列号：
  定i=加起始位置2。
  定j=i。
  当j小于长源码：
    定c1=入源码j。
    定c2=入源码加j1。
    当且c1等于"}"c2等于"}"：定代码=截取源码i加j1。定token=列TOKEN_PYTHON代码行号列号。返回token j加2 token 行号列号。。j=加j1。。返回j加2 token 行号列号。
．

-- 扫描字符串
定扫描字符串=函源码起始位置行号列号：
  定i=加起始位置1。
  定j=i。
  当j小于长源码：
    定c=入源码j。当c等于"""：定值=截取源码i加j1。定token=列TOKEN_STR值行号列号。返回token j加1 token 行号列号。。当c等于"\\"：j=加j2。。j=加j1。。返回j token 行号列号。
．

-- 扫描数字
定扫描数字=函源码起始位置行号列号：
  定i=起始位置。
  当i小于长源码：
    定c=入源码i。当是数字字符：i=加i1。。返回i列TOKEN_NUM截取源码起始位置加i1行号列号。
．

-- 扫描英文标识符
定扫描英文标识符=函源码起始位置行号列号：
  定i=起始位置。
  当i小于长源码：
    定c=入源码i。定码=入c0。当且或且码大于等于65码小于等于90或且码大于等于97码小于等于122或码等于95或是数字字符：i=加i1。。定值=截取源码起始位置加i1。当是关键字值：返回i列TOKEN_KEYWORD值行号列号。。当是动词值：返回i列TOKEN_VERB值行号列号。。返回i列TOKEN_WORD值行号列号。
．

-- 扫描中文标识符
定扫描中文标识符=函源码起始位置行号列号：
  定i=起始位置。
  当i小于长源码：
    定c=入源码i。当是中文字符：i=加i1。。定值=截取源码起始位置加i1。当是关键字值：返回i列TOKEN_KEYWORD值行号列号。。当是动词值：返回i列TOKEN_VERB值行号列号。。返回i列TOKEN_WORD值行号列号。
．

-- 主词法分析函数
定tokenize=函源码：
  定tokens=列。
  定i=0。
  定行号=1。
  定列号=1。
  当i小于长源码：
    定c=入源码i。
    当c等于" "：i=加i1。列号=加列号1。。当c等于"\t"：i=加i1。列号=加列号4。。当c等于"\n"：i=加i1。行号=加行号1。列号=1。。当c等于"\r"：i=加i1。。当且c等于"{"入源码加i1等于"{"：定结果=扫描Python源码i行号列号。i=取结果0。定token=取结果1。定新行号=取结果2。定新列号=取结果3。连tokens列token。行号=新行号。列号=新列号。。当是特殊字符c：定token类型=取特殊字符类型c。定token=列token类型c行号列号。连tokens列token。i=加i1。列号=加列号1。。当c等于"""：定结果=扫描字符串源码i行号列号。i=取结果0。定token=取结果1。连tokens列token。。当是数字字符c：定结果=扫描数字源码i行号列号。i=取结果0。定token=取结果1。连tokens列token。列号=加列号1。。当是字母字符c：定结果=扫描英文标识符源码i行号列号。i=取结果0。定token=取结果1。连tokens列token。列号=加列号1。。当是中文字符c：定结果=扫描中文标识符源码i行号列号。i=取结果0。定token=取结果1。连tokens列token。列号=加列号1。。当且c等于"-"入源码加i1等于"-"：当i小于长源码：定c2=入源码i。当c2等于"\n"：i=加i1。。i=加i1。。i=加i1。列号=加列号1。
  。
  定eof=列TOKEN_EOF空行号列号。连tokens列eof。返回tokens。
．

-- 辅助函数：获取Token字符串表示
定token_to_str=函token：
  当token等于空：返回"空"。。定类型=入token0。定值=入token1。定行号=入token2。定列号=入token3。返回连"("连类型连"，’"连值连"’，行"连行号连"，列"连列号连")".
．

-- 辅助函数：打印Token列表
定print_tokens=函tokens：
  定i=0。
  当i小于长tokens：
    定token=入tokensi。印token_to_str token。i=加i1。
  。
