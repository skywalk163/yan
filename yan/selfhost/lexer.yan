-- 词法分析器模块（优化版）

-- Token类型常量
定TOKEN_EOF=0。
定TOKEN_WORD=1。
定TOKEN_NUM=2。
定TOKEN_STR=3。
定TOKEN_COMMA=4。
定TOKEN_DOT=5。
定TOKEN_COLON=6。
定TOKEN_EQUALS=7。
定TOKEN_SEMI=8。
定TOKEN_QUOTE=9。
定TOKEN_PYTHON=10。
定TOKEN_KEYWORD=11。
定TOKEN_VERB=12。

-- 关键字集合（使用字典加速查找）
定关键字=列"定" "函" "若" "则" "否则" "当" "真" "假" "空" "无"。
定关键字集合=典。
定i=0。当i小于长关键字：定词=取关键字i。定关键字集合=典词真。i=加i1。

-- 动词集合（使用字典加速查找）
定动词=列"加" "减" "乘" "除" "等于" "大于" "小于" "列" "印" "取" "入" "长" "连"。
定动词集合=典。
定j=0。当j小于长动词：定词=取动词j。定动词集合=典词真。j=加j1。

-- 特殊字符映射表（直接查找）
定特殊字符映射=典。
定特殊字符映射=典"，"TOKEN_COMMA。
定特殊字符映射=典"。"TOKEN_DOT。
定特殊字符映射=典"："TOKEN_COLON。
定特殊字符映射=典"="TOKEN_EQUALS。
定特殊字符映射=典"；"TOKEN_SEMI。
定特殊字符映射=典"’"TOKEN_QUOTE。

-- 判断是否是特殊字符（查表法）
定是特殊字符=函字符：
  定val=入特殊字符映射字符。当val不等于空：返回真。。返回假

-- 获取特殊字符类型（查表法）
定取特殊字符类型=函字符：
  定val=入特殊字符映射字符。当val不等于空：返回val。。返回TOKEN_WORD

-- 判断是否是关键字（查表法）
定是关键字=函词：
  定val=入关键字集合词。当val不等于空：返回真。。返回假

-- 判断是否是动词（查表法）
定是动词=函词：
  定val=入动词集合词。当val不等于空：返回真。。返回假

-- 字符类型判断优化（使用Unicode码点范围）
定是数字字符=函字符：
  定码=入字符0
  且码大于等于48码小于等于57

定是字母字符=函字符：
  定码=入字符0
  或且码大于等于65码小于等于90且码大于等于97码小于等于122

定是中文字符=函字符：
  定码=入字符0
  且码大于2047码小于等于65535

定是空白字符=函字符：
  定码=入字符0
  或码等于32或码等于9或码等于10或码等于13

-- 跳过空白字符（优化版）
定跳过空白=函源码位置：
  定i=位置
  当真：
    当i大于等于长源码：返回i
    定c=入源码i
    当c等于""：返回i
    当不是空白字符c：返回i
    i=加i1

-- 扫描Python代码块
定扫描Python=函源码起始位置：
  定i=加起始位置2
  定j=i
  定depth=1
  当j小于长源码：
    定c1=入源码j
    定c2=入源码加j1
    当且c1等于"{"c2等于"{"：depth=加depth1。j=加j2。
    当且c1等于"}"c2等于"}"：depth=减depth1。当depth等于0：定代码=截取源码i加j1。定token=列TOKEN_PYTHON代码。返回列加j2token。。j=加j2。
    j=加j1
  返回列加j1列TOKEN_PYTHON截取源码i j

-- 扫描字符串
定扫描字符串=函源码起始位置：
  定i=加起始位置1
  定j=i
  当j小于长源码：
    定c=入源码j
    当c等于"""：定值=截取源码i加j1。定token=列TOKEN_STR值。返回列加j1token。
    当且c等于"\\"加j1小于长源码：j=加j2。
    j=加j1
  返回列j列TOKEN_STR截取源码i j

-- 扫描数字（优化版）
定扫描数字=函源码起始位置：
  定i=起始位置
  当i小于长源码：
    定c=入源码i
    当不是数字字符c：返回列i列TOKEN_NUM截取源码起始位置i。
    i=加i1
  返回列i列TOKEN_NUM截取源码起始位置i

-- 扫描英文标识符（优化版）
定扫描英文标识符=函源码起始位置：
  定i=起始位置
  当i小于长源码：
    定c=入源码i
    定码=入c0
    当且或且码大于等于65码小于等于90或且码大于等于97码小于等于122或码等于95或是数字字符c：i=加i1。。否则：返回列i列TOKEN_WORD截取源码起始位置i。
  返回列i列TOKEN_WORD截取源码起始位置i

-- 扫描中文标识符（优化版）
定扫描中文标识符=函源码起始位置：
  定i=起始位置
  当i小于长源码：
    定c=入源码i
    当是中文字符c：i=加i1。。否则：返回列i列TOKEN_WORD截取源码起始位置i。
  返回列i列TOKEN_WORD截取源码起始位置i

-- 主词法分析函数（优化版）
定tokenize=函源码：
  定tokens=列
  定i=0
  定len源码=长源码
  当i小于len源码：
    定c=入源码i
    当是空白字符c：i=加i1。
    当且c等于"{"加i1小于len源码入源码加i1等于"{"：定结果=扫描Python源码i。i=取结果0。定token=取结果1。连tokens列token。
    当是特殊字符c：定token类型=取特殊字符类型c。定token=列token类型c。连tokens列token。i=加i1。
    当c等于"""：定结果=扫描字符串源码i。i=取结果0。定token=取结果1。连tokens列token。
    当是数字字符c：定结果=扫描数字源码i。i=取结果0。定token=取结果1。连tokens列token。
    当是字母字符c：定结果=扫描英文标识符源码i。i=取结果0。定token=取结果1。连tokens列token。
    当是中文字符c：定结果=扫描中文标识符源码i。i=取结果0。定token=取结果1。连tokens列token。
    当且c等于"-"加i1小于len源码入源码加i1等于"-"：当加i2小于len源码入源码加i2不等于"\n"：i=加i1。。i=加i1。
  定eof=列TOKEN_EOF空。连tokens列eof。返回tokens

-- 辅助函数：获取Token字符串表示
定token_to_str=函token：
  当token等于空：返回"空"
  定类型=入token0
  定值=入token1
  返回连"("连类型连"，’"连值连"’)"

-- 辅助函数：打印Token列表
定print_tokens=函tokens：
  定i=0
  当i小于长tokens：
    定token=入tokensi
    印token_to_str token
    i=加i1
