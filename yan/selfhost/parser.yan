-- 语法分析器模块（纯言语言实现）

-- 关键字列表
定关键字=列"定" "函" "若" "则" "否则" "当" "真" "假" "空" "无"。

-- 辅助函数：获取Token类型
定取类型=函token：
  定类型=入token0。
  返回类型。
．

-- 辅助函数：获取Token值
定取值=函token：
  定值=入token1。
  返回值。
．

-- 辅助函数：获取Token行号
定取行号=函token：
  定行号=入token2。
  返回行号。
．

-- 辅助函数：获取Token列号
定取列号=函token：
  定列号=入token3。
  返回列号。
．

-- 辅助函数：获取Token列表长度
定token长度=函tokens：
  定计数=0。
  当真：
    当计数小于100000：
      定c=tokens计数。
      当c等于空：
        返回计数。
      。
      计数=加计数1。
    。
    返回计数。
  。
．

-- 辅助函数：获取Token列表元素
定token取=函tokens索引：
  定长度=token长度tokens。
  当或索引小于0或索引大于等于长度：
    返回空。
  。
  定计数=0。
  当计数小于索引：
    计数=加计数1。
  。
  定当前=tokens0。
  定i=0。
  当i小于计数：
    当前=tokensi。
    i=加i1。
  。
  当真：
    当i等于索引：
      返回tokensi。
    。
    i=加i1。
  。
．

-- 获取当前Token
定当前=函tokens位置长度：
  当位置小于长度：
    返回tokens位置。
  。
  返回空。
．

-- 前进到下一个Token
定前进=函tokens位置：
  返回加位置1。
．

-- 向前看一个Token
定向前看=函tokens位置长度：
  当加位置1小于长度：
    返回tokens加位置1。
  。
  返回空。
．

-- 判断Token类型
定是类型=函token类型：
  当token等于空：
    返回假。
  。
  定t=取类型token。
  返回t等于类型。
．

-- 判断Token值
定是值=函token值：
  当token等于空：
    返回假。
  。
  定v=取值token。
  返回v等于值。
．

-- 创建错误
定创建错误=函消息行号列号：
  定错误=列消息行号列号。
  返回错误。
．

-- 添加错误到列表
定添错误=函错误列表消息行号列号：
  定错误=创建错误消息行号列号。
  连错误列表列错误。
  返回错误列表。
．

-- 解析语句
定解析语句=函tokens位置长度错误列表：
  定tok=当前tokens位置长度。
  当tok等于空：
    返回位置错误列表空。
  。
  定类型=取类型tok。
  当类型等于0：
    返回位置错误列表空。
  。
  当类型等于6：
    定新位置=前进位置。
    返回新位置错误列表空。
  。
  当类型等于8：
    定新位置=前进位置。
    返回新位置错误列表空。
  。
  当类型等于10：
    返回解析Python代码tokens位置长度错误列表。
  。
  当且类型等于11取值tok等于"定"：
    返回解析定义tokens位置长度错误列表。
  。
  当且类型等于11取值tok等于"若"：
    返回解析条件tokens位置长度错误列表。
  。
  当且类型等于11取值tok等于"当"：
    返回解析循环tokens位置长度错误列表。
  。
  返回解析表达式tokens位置长度错误列表。
．

-- 解析Python代码
定解析Python代码=函tokens位置长度错误列表：
  定tok=当前tokens位置长度。
  定值=取值tok。
  定新位置=前进位置。
  定node=列12值。
  返回新位置错误列表node。
．

-- 解析定义
定解析定义=函tokens位置长度错误列表：
  定新位置1=前进位置。
  定tok=当前tokens新位置1长度。
  当tok等于空：
    返回位置错误列表创建错误"缺少变量名"0 0。
  。
  定名称=取值tok。
  定新位置2=前进新位置1。
  定当前tok=当前tokens新位置2长度。
  当当前tok等于空：
    返回新位置2错误列表创建错误"缺少表达式"0 0。
  。
  定类型=取类型当前tok。
  当类型等于9：
    定新位置3=前进新位置2。
    定expr=解析表达式tokens新位置3长度错误列表。
    定node=列7名称expr。
    返回expr。
  。
  定expr=解析表达式tokens新位置2长度错误列表。
  定node=列7名称expr。
  返回expr。
．

-- 解析条件
定解析条件=函tokens位置长度错误列表：
  定新位置1=前进位置。
  定cond=解析表达式tokens新位置1长度错误列表。
  定新位置2=取cond0。
  定错误列表2=取cond1。
  定cond_expr=取cond2。
  定当前tok=当前tokens新位置2长度。
  当且类型等于11取值当前tok等于"则"：
    定新位置3=前进新位置2。
    定then_branch=解析表达式tokens新位置3长度错误列表2。
    定新位置4=取then_branch0。
    定错误列表3=取then_branch1。
    定then_expr=取then_branch2。
    定当前tok2=当前tokens新位置4长度。
    定else_branch=空。
    定新位置5=新位置4。
    定错误列表4=错误列表3。
    当且类型等于11取值当前tok2等于"否则"：
      定新位置6=前进新位置4。
      定else_result=解析表达式tokens新位置6长度错误列表3。
      定新位置5=取else_result0。
      定错误列表4=取else_result1。
      定else_branch=取else_result2。
    。
    定node=列10cond_exprthen_exprelse_branch。
    返回新位置5错误列表4node。
  。
  定then_branch=解析表达式tokens新位置2长度错误列表2。
  定node=列10cond_exprthen_branch。
  返回then_branch。
．

-- 解析循环
定解析循环=函tokens位置长度错误列表：
  定新位置1=前进位置。
  定cond=解析表达式tokens新位置1长度错误列表。
  定新位置2=取cond0。
  定错误列表2=取cond1。
  定cond_expr=取cond2。
  定当前tok=当前tokens新位置2长度。
  当且类型等于11取值当前tok等于"则"：
    定新位置3=前进新位置2。
    定body=解析表达式tokens新位置3长度错误列表2。
    定node=列11cond_exprbody。
    返回body。
  。
  当类型等于6：
    定新位置4=前进新位置2。
    定body=解析表达式tokens新位置4长度错误列表2。
    定node=列11cond_exprbody。
    返回body。
  。
  定body=解析表达式tokens新位置2长度错误列表2。
  定node=列11cond_exprbody。
  返回body。
．

-- 解析表达式
定解析表达式=函tokens位置长度错误列表：
  定term=解析项tokens位置长度错误列表。
  定新位置=取term0。
  定错误列表2=取term1。
  定expr=取term2。
  定node=列6expr。
  返回新位置错误列表2node。
．

-- 解析项
定解析项=函tokens位置长度错误列表：
  定tok=当前tokens位置长度。
  当tok等于空：
    定node=列6空。
    返回位置错误列表node。
  。
  定类型=取类型tok。
  定值=取值tok。
  当类型等于1：
    定verb=值。
    定新位置1=前进位置。
    定peek=向前看tokens新位置1长度。
    当且peek不等于空取类型peek等于11取值peek等于"函"：
      返回解析Lambdaverbtokens新位置1长度错误列表。
    。
    定args=列。
    定当前位置=新位置1。
    定当前错误列表=错误列表。
    当真：
      定current=当前tokens当前位置长度。
      当current等于空：
        返回当前位置当前错误列表创建调用verbargs。
      。
      定c_type=取类型current。
      当c_type等于11：
        定c_value=取值current。
        当或c_value等于"若"或c_value等于"当"或c_value等于"定"或c_value等于"否则"或c_value等于"则"：
          定node=创建调用verbargs。
          返回当前位置当前错误列表node。
        。
      。
      当c_type等于6或c_type等于8或c_type等于4或c_type等于0：
        定node=创建调用verbargs。
        返回当前位置当前错误列表node。
      。
      定arg=解析表达式tokens当前位置长度当前错误列表。
      定当前位置=取arg0。
      定当前错误列表=取arg1。
      连args列取arg2。
    。
  。
  当类型等于2：
    定num=值。
    定新位置=前进位置。
    定node=列2num。
    返回新位置错误列表node。
  。
  当类型等于3：
    定str=值。
    定新位置=前进位置。
    定node=列3str。
    返回新位置错误列表node。
  。
  当类型等于11：
    当值等于"真"：
      定新位置=前进位置。
      定node=列4真。
      返回新位置错误列表node。
    。
    当值等于"假"：
      定新位置=前进位置。
      定node=列4假。
      返回新位置错误列表node。
    。
    当或值等于"空"或值等于"无"：
      定新位置=前进位置。
      定node=列5。
      返回新位置错误列表node。
    。
  。
  定node=列6空。
  返回位置错误列表node。
．

-- 解析Lambda
定解析Lambda=函名称tokens位置长度错误列表：
  定新位置1=前进位置。
  定参数=列。
  当真：
    定tok=当前tokens新位置1长度。
    当tok等于空：返回新位置1错误列表创建函数名称参数空。。当取类型tok不等于1：返回新位置1错误列表创建函数名称参数空。。连参数列取值tok。定新位置2=前进新位置1。定peek=向前看tokens新位置2长度。当peek等于空：返回新位置2错误列表创建函数名称参数空。。当取类型peek等于6：定新位置3=前进新位置2。定body=解析表达式tokens新位置3长度错误列表。定body_node=取body2。返回取body0取body1创建函数名称参数body_node。.当取类型peek等于11：当peek等于空：返回新位置2错误列表创建函数名称参数空。.当取值peek等于"若"或取值peek等于"当"或取值peek等于"定"或取值peek等于"否则"或取值peek等于"则"：定body=解析表达式tokens新位置2长度错误列表。定body_node=取body2。返回取body0取body1创建函数名称参数body_node。.新位置1=新位置2。.

-- 创建调用节点
定创建调用=函verb args：
  定node=列9verb args。
  返回node。
．

-- 创建函数节点
定创建函数=函名称参数体：
  定node=列8名称参数体。
  返回node。
．

-- 解析程序
定parse=函tokens：
  定长度=token长度tokens。
  定位置=0。
  定语句=列。
  定错误列表=列。
  当真：
    当位置大于等于长度：返回。.定tok=当前tokens位置长度。当tok等于空：返回。.定类型=取类型tok。当类型等于0：返回。.定result=解析语句tokens位置长度错误列表。定新位置=取result0。定result_errors=取result1。定stmt=取result2。连错误列表result_errors。当stmt不等于空：连语句列stmt。.位置=新位置。
  。定node=列1语句。返回列node错误列表.

-- 辅助函数：获取错误信息
定get_errors=函parse_result：
  当parse_result等于空：返回列。.
  定errors=入parse_result1。
  返回errors。
．

-- 辅助函数：获取AST
定get_ast=函parse_result：
  当parse_result等于空：返回空。
  定ast=入parse_result0。
  返回ast。
．

-- 辅助函数：打印错误
定print_errors=函errors：
  定i=0。
  当i小于长errors：
    定错误=errors i。
    当错误不等于空：
      定消息=错误0。
      定行号=错误1。
      定列号=错误2。
      印连"错误 (行"连行号连", 列"连列号连"): "连消息.
    。
    i=加i1。
  。
