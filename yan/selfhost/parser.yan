-- 语法分析器模块（优化版）

-- 关键字集合（使用字典加速）
定关键字集合=典。
定关键字集合=典"定"真。
定关键字集合=典"函"真。
定关键字集合=典"若"真。
定关键字集合=典"则"真。
定关键字集合=典"否则"真。
定关键字集合=典"当"真。
定关键字集合=典"真"真。
定关键字集合=典"假"真。
定关键字集合=典"空"真。
定关键字集合=典"无"真。

-- 辅助函数：获取Token类型
定取类型=函token：入token0。

-- 辅助函数：获取Token值
定取值=函token：入token1。

-- 辅助函数：获取Token列表长度（优化版）
定token长度=函tokens：长tokens。

-- 辅助函数：获取Token列表元素（优化版）
定token取=函tokens索引：入tokens索引。

-- 获取当前Token
定当前=函tokens位置长度：当位置小于长度：返回入tokens位置。。返回空。

-- 前进到下一个Token
定前进=函位置：加位置1。

-- 向前看一个Token
定向前看=函tokens位置长度：当加位置1小于长度：返回入tokens加位置1。。返回空。

-- 判断Token类型
定是类型=函token类型：当token等于空：返回假。。定t=取类型token。返回t等于类型。

-- 判断Token值
定是值=函token值：当token等于空：返回假。。定v=取值token。返回v等于值。

-- 判断是否是关键字（查表法）
定是关键字=函词：定val=入关键字集合词。当val不等于空：返回真。。返回假。

-- 创建错误
定创建错误=函消息行号列号：列消息行号列号。

-- 创建调用节点
定创建调用=函verb args：列9verb args。

-- 创建函数节点
定创建函数=函名称参数体：列8名称参数体。

-- 解析语句
定解析语句=函tokens位置长度错误列表：
  定tok=当前tokens位置长度
  当tok等于空：返回列位置错误列表空
  定类型=取类型tok
  当类型等于0：返回列位置错误列表空
  当类型等于6：定新位置=前进位置。返回列新位置错误列表空
  当类型等于8：定新位置=前进位置。返回列新位置错误列表空
  当类型等于10：返回解析Python代码tokens位置长度错误列表
  定val=取值tok
  当且类型等于11是关键字val：
    当val等于"定"：返回解析定义tokens位置长度错误列表
    当val等于"若"：返回解析条件tokens位置长度错误列表
    当val等于"当"：返回解析循环tokens位置长度错误列表
  返回解析表达式tokens位置长度错误列表

-- 解析Python代码
定解析Python代码=函tokens位置长度错误列表：
  定tok=当前tokens位置长度
  定值=取值tok
  定新位置=前进位置
  定node=列12值
  返回列新位置错误列表node

-- 解析定义
定解析定义=函tokens位置长度错误列表：
  定新位置1=前进位置
  定tok=当前tokens新位置1长度
  当tok等于空：返回列位置连错误列表列创建错误"缺少变量名"0 0空
  定名称=取值tok
  定新位置2=前进新位置1
  定expr=解析表达式tokens新位置2长度错误列表
  定node=列7名称取expr2
  返回列取expr0取expr1node

-- 解析条件
定解析条件=函tokens位置长度错误列表：
  定新位置1=前进位置
  定cond=解析表达式tokens新位置1长度错误列表
  定新位置2=取cond0
  定错误列表2=取cond1
  定cond_expr=取cond2
  定当前tok=当前tokens新位置2长度
  当且取类型当前tok等于11取值当前tok等于"则"：
    定新位置3=前进新位置2
    定then_branch=解析表达式tokens新位置3长度错误列表2
    定新位置4=取then_branch0
    定错误列表3=取then_branch1
    定then_expr=取then_branch2
    定当前tok2=当前tokens新位置4长度
    定else_branch=空
    定新位置5=新位置4
    定错误列表4=错误列表3
    当且取类型当前tok2等于11取值当前tok2等于"否则"：
      定新位置6=前进新位置4
      定else_result=解析表达式tokens新位置6长度错误列表3
      定新位置5=取else_result0
      定错误列表4=取else_result1
      定else_branch=取else_result2
    定node=列10cond_exprthen_exprelse_branch
    返回列新位置5错误列表4node
  定then_branch=解析表达式tokens新位置2长度错误列表2
  定node=列10cond_expr取then_branch2
  返回列取then_branch0取then_branch1node

-- 解析循环
定解析循环=函tokens位置长度错误列表：
  定新位置1=前进位置
  定cond=解析表达式tokens新位置1长度错误列表
  定新位置2=取cond0
  定错误列表2=取cond1
  定cond_expr=取cond2
  定当前tok=当前tokens新位置2长度
  当且取类型当前tok等于11取值当前tok等于"则"：
    定新位置3=前进新位置2
    定body=解析表达式tokens新位置3长度错误列表2
    定node=列11cond_expr取body2
    返回body
  当取类型当前tok等于6：
    定新位置4=前进新位置2
    定body=解析表达式tokens新位置4长度错误列表2
    定node=列11cond_expr取body2
    返回body
  定body=解析表达式tokens新位置2长度错误列表2
  定node=列11cond_expr取body2
  返回body

-- 解析表达式
定解析表达式=函tokens位置长度错误列表：
  定term=解析项tokens位置长度错误列表
  定node=列6取term2
  返回列取term0取term1node

-- 解析项
定解析项=函tokens位置长度错误列表：
  定tok=当前tokens位置长度
  当tok等于空：返回列位置错误列表列6空
  定类型=取类型tok
  定值=取值tok
  当类型等于1：
    定verb=值
    定新位置1=前进位置
    定peek=向前看tokens新位置1长度
    当且peek不等于空取类型peek等于11取值peek等于"函"：
      返回解析Lambdaverbtokens新位置1长度错误列表
    定args=列
    定当前位置=新位置1
    定当前错误列表=错误列表
    当真：
      定current=当前tokens当前位置长度
      当current等于空：返回列当前位置当前错误列表创建调用verbargs
      定c_type=取类型current
      当c_type等于11：
        定c_value=取值current
        当或c_value等于"若"或c_value等于"当"或c_value等于"定"或c_value等于"否则"或c_value等于"则"：
          返回列当前位置当前错误列表创建调用verbargs
      当或c_type等于6或c_type等于8或c_type等于4或c_type等于0：
        返回列当前位置当前错误列表创建调用verbargs
      定arg=解析表达式tokens当前位置长度当前错误列表
      定当前位置=取arg0
      定当前错误列表=取arg1
      连args列取arg2
  当类型等于2：
    定新位置=前进位置
    返回列新位置错误列表列2值
  当类型等于3：
    定新位置=前进位置
    返回列新位置错误列表列3值
  当类型等于11：
    当值等于"真"：定新位置=前进位置。返回列新位置错误列表列4真
    当值等于"假"：定新位置=前进位置。返回列新位置错误列表列4假
    当或值等于"空"或值等于"无"：定新位置=前进位置。返回列新位置错误列表列5
  返回列位置错误列表列6空

-- 解析Lambda
定解析Lambda=函名称tokens位置长度错误列表：
  定新位置1=前进位置
  定参数=列
  当真：
    定tok=当前tokens新位置1长度
    当tok等于空：返回列新位置1错误列表创建函数名称参数空
    当取类型tok不等于1：返回列新位置1错误列表创建函数名称参数空
    连参数列取值tok
    定新位置2=前进新位置1
    定peek=向前看tokens新位置2长度
    当peek等于空：返回列新位置2错误列表创建函数名称参数空
    当取类型peek等于6：
      定新位置3=前进新位置2
      定body=解析表达式tokens新位置3长度错误列表
      返回列取body0取body1创建函数名称参数取body2
    当取类型peek等于11：
      定peek_val=取值peek
      当或peek_val等于"若"或peek_val等于"当"或peek_val等于"定"或peek_val等于"否则"或peek_val等于"则"：
        定body=解析表达式tokens新位置2长度错误列表
        返回列取body0取body1创建函数名称参数取body2
    新位置1=新位置2

-- 解析程序
定parse=函tokens：
  定长度=token长度tokens
  定位置=0
  定语句=列
  定错误列表=列
  当真：
    当位置大于等于长度：返回列列1语句错误列表
    定tok=当前tokens位置长度
    当tok等于空：返回列列1语句错误列表
    定类型=取类型tok
    当类型等于0：返回列列1语句错误列表
    定result=解析语句tokens位置长度错误列表
    定新位置=取result0
    定stmt=取result2
    当stmt不等于空：连语句列stmt
    位置=新位置

-- 辅助函数：获取错误信息
定get_errors=函parse_result：当parse_result等于空：返回列。。入parse_result1。

-- 辅助函数：获取AST
定get_ast=函parse_result：当parse_result等于空：返回空。。入parse_result0。

-- 辅助函数：打印错误
定print_errors=函errors：
  定i=0
  当i小于长errors：
    定错误=入errorsi
    当错误不等于空：
      定消息=入错误0
      定行号=入错误1
      定列号=入错误2
      印连"错误 (行"连行号连", 列"连列号连"): "连消息
    i=加i1
