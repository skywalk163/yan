-- Token定义模块（纯言语言实现）

-- Token类型常量
定NUM=1。
定STR=2。
定WORD=3。
定KEYWORD=4。
定VERB=5。
定DOT=6。
定COMMA=7。
定COLON=8。
定EQUALS=9。
定PYTHON=10。
定EOF=11。

-- 创建Token（使用 Python 代码块，因为需要返回元组）
定创建Token=函类型值行列：
  定元组=列类型值行列。
  返回元组。
。

-- 获取Token属性（使用 Python 代码块，因为需要访问元组元素）
定取类型=函token：
  定结果=空。
  定i=0。
  当i等于0：
    结果=入token0。
    i=加i1。
  。
  返回结果。
。

定取值=函token：
  定结果=空。
  定i=0。
  当i等于0：
    结果=入token1。
    i=加i1。
  。
  返回结果。
。

定取行=函token：
  定结果=空。
  定i=0。
  当i等于0：
    结果=入token2。
    i=加i1。
  。
  返回结果。
。

定取列=函token：
  定结果=空。
  定i=0。
  当i等于0：
    结果=入token3。
    i=加i1。
  。
  返回结果。
。

-- 关键字列表
定关键字列表=列"定" "函" "若" "则" "否则" "当" "真" "假" "空" "无"。

-- 关键字判断
定是关键字=函词：
  定i=0。
  当i小于长关键字列表：
    若取关键字列表i等于词：
      返回真。
    。
    i=加i1。
  。
  返回假。
。

-- 动词列表
定动词列表=列"加" "减" "乘" "除" "等于" "大于" "小于" "列" "印" "取" "入" "长" "连"。

-- 动词判断
定是动词=函词：
  定i=0。
  当i小于长动词列表：
    若取动词列表i等于词：
      返回真。
    。
    i=加i1。
  。
  返回假。
。

-- 辅助函数：获取列表长度
定长=函列表：
  定计数=0。
  当真：
    当计数小于100000：
      定c=列表计数。
      当c等于空：
        返回计数。
      。
      计数=加计数1。
    。
    返回计数。
  。
。

-- 辅助函数：获取列表元素
定取=函列表索引：
  定长度=长列表。
  当或索引小于0或索引大于等于长度：
    返回空。
  。
  定计数=0。
  当计数小于索引：
    计数=加计数1。
  。
  定当前=列表0。
  定i=0。
  当i小于计数：
    当前=列表i。
    i=加i1。
  。
  当真：
    当i等于索引：
      返回列表i。
    。
    i=加i1。
  。

