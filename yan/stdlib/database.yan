-- 数据库模块（database.yan）
-- 提供SQLite数据库操作功能

-- 导出声明
出 打开数据库, 关闭数据库,
    执行SQL, 查询, 查询单行, 查询单个值,
    开始事务, 提交事务, 回滚事务,
    创建表, 删除表, 表存在,
    插入, 更新, 删除,
    创建索引, 删除索引,
    备份数据库, 恢复数据库

-- 打开数据库连接
定 打开数据库 = 函 路径：
  返回 打开数据库 路径。


-- 关闭数据库连接
定 关闭数据库 = 函 连接：
  返回 关闭数据库 连接。


-- 执行SQL语句（无返回结果）
定 执行SQL = 函 连接 SQL 参数：
  当 参数 等于 空：
    返回 执行SQL 连接 SQL

  返回 执行SQL 连接 SQL 参数。


-- 执行查询并返回所有结果
定 查询 = 函 连接 SQL 参数：
  当 参数 等于 空：
    返回 查询 连接 SQL

  返回 查询 连接 SQL 参数。


-- 执行查询并返回单行
定 查询单行 = 函 连接 SQL 参数：
  当 参数 等于 空：
    返回 查询单行 连接 SQL

  返回 查询单行 连接 SQL 参数。


-- 执行查询并返回单个值
定 查询单个值 = 函 连接 SQL 参数：
  当 参数 等于 空：
    返回 查询值 连接 SQL

  返回 查询值 连接 SQL 参数。


-- 开始事务
定 开始事务 = 函 连接：
  执行SQL 连接 "BEGIN TRANSACTION" 空。


-- 提交事务
定 提交事务 = 函 连接：
  执行SQL 连接 "COMMIT" 空。


-- 回滚事务
定 回滚事务 = 函 连接：
  执行SQL 连接 "ROLLBACK" 空。


-- 创建表
定 创建表 = 函 连接 表名 列定义：
  定 列字符串 = 空串。
  定 键 = 键 列定义
  定 i = 0
  当 i 小于 长 键：
    定 k = 取 键 i
    定 v = 值 列定义 k
    当 i 大于 0：
      定 列字符串 = 连 列字符串 ", "

    定 列字符串 = 连 列字符串 k " " v。
    定 i = 加 i 1。

  定 SQL = 连 "CREATE TABLE IF NOT EXISTS " 表名 " (" 列字符串 ")"。
  执行SQL 连接 SQL 空。


-- 删除表
定 删除表 = 函 连接 表名：
  定 SQL = 连 "DROP TABLE IF EXISTS " 表名。
  执行SQL 连接 SQL 空


-- 检查表是否存在
定 表存在 = 函 连接 表名：
  定 SQL = "SELECT name FROM sqlite_master WHERE type='table' AND name=?"。
  定 结果 = 查询单行 连接 SQL 列 表名
  当 结果 不等于 空：
    返回 真

  返回 假。


-- 插入记录
定 插入 = 函 连接 表名 数据：
  返回 插入记录 连接 表名 数据。


-- 更新记录
定 更新 = 函 连接 表名 数据 条件 参数：
  定 列字符串 = 空串。
  定 键 = 键 数据
  定 i = 0
  当 i 小于 长 键：
    定 k = 取 键 i
    当 i 大于 0：
      定 列字符串 = 连 列字符串 ", "

    定 列字符串 = 连 列字符串 k "=?"。
    定 i = 加 i 1。

  定 SQL = 连 "UPDATE " 表名 " SET " 列字符串 " WHERE " 条件。
  执行SQL 连接 SQL 参数。


-- 删除记录
定 删除 = 函 连接 表名 条件 参数：
  定 SQL = 连 "DELETE FROM " 表名 " WHERE " 条件。
  执行SQL 连接 SQL 参数


-- 创建索引
定 创建索引 = 函 连接 索引名 表名 列名 唯一：
  定 唯一字符串 = 空串。
  当 唯一：
    定 唯一字符串 = "UNIQUE "

  定 SQL = 连 "CREATE " 唯一字符串 "INDEX IF NOT EXISTS " 索引名 " ON " 表名 " (" 列名 ")"。
  执行SQL 连接 SQL 空。


-- 删除索引
定 删除索引 = 函 连接 索引名：
  定 SQL = 连 "DROP INDEX IF EXISTS " 索引名。
  执行SQL 连接 SQL 空


-- 备份数据库
定 备份数据库 = 函 连接 备份路径：
  定 SQL = ".dump"。
  定 结果 = 查询 连接 SQL 空
  写文件 备份路径 结果


-- 恢复数据库
定 恢复数据库 = 函 连接 备份路径：
  定 SQL = 读文件 备份路径。
  执行SQL 连接 SQL 空
