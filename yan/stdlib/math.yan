-- 数学运算模块（math.yan）

-- 注：本模块提供数学运算函数

-- 圆周率常量
定π=3.141592653589793。
定圆周率=π。

-- 自然常数
定e=2.718281828459045。
定自然常数=e。

-- 绝对值
定绝对=函x：{{ abs(x) }}。

-- 向上取整
定上取整=函x：{{ math.ceil(x) }}。

-- 向下取整
定下取整=函x：{{ math.floor(x) }}。

-- 四舍五入
定四舍五入=函x小数位：
  当小数位等于空：定小数位=0。
  {{ round(x, ndigits) }}
．

-- 指数运算
定指数=函x：{{ math.exp(x) }}。

-- 对数运算
定对数=函x：{{ math.log(x) }}。

-- 以10为底的对数
定对数10=函x：{{ math.log10(x) }}。

-- 开平方
定开方=函x：{{ math.sqrt(x) }}。

-- 幂运算
定幂=函底指数：{{ base ** exp }}。

-- 平方根
定平方根=函x：{{ math.sqrt(x) }}。

-- 立方根
定立方根=函x：{{ x ** (1/3) }}。

-- 正弦
定正弦=函x：{{ math.sin(x) }}。

-- 余弦
定余弦=函x：{{ math.cos(x) }}。

-- 正切
定正切=函x：{{ math.tan(x) }}。

-- 反正弦
定反正弦=函x：{{ math.asin(x) }}。

-- 反余弦
定反余弦=函x：{{ math.acos(x) }}。

-- 反正切
定反正切=函x：{{ math.atan(x) }}。

-- 双曲正弦
定双曲正弦=函x：{{ math.sinh(x) }}。

-- 双曲余弦
定双曲余弦=函x：{{ math.cosh(x) }}。

-- 双曲正切
定双曲正切=函x：{{ math.tanh(x) }}。

-- 最大值
定最大值=函...：
  当长参数等于0：返回0。
  当长参数等于1：返回参数0。
  定最大=参数0。
  定i=1。
  当i小于长参数：
    当参数i大于最大：定最大=参数i。。i=加i1。
  。返回最大。
．

-- 最小值
定最小值=函...：
  当长参数等于0：返回0。
  当长参数等于1：返回参数0。
  定最小=参数0。
  定i=1。
  当i小于长参数：
    当参数i小于最小：定最小=参数i。。i=加i1。
  。返回最小。
．

-- 求和
定求和=函列表：
  当列表等于空：返回0。
  定总和=0。
  定i=0。当i小于长列表：定总和=加总和入列表i。i=加i1。返回总和。
．

-- 平均值
定平均值=函列表：
  当列表等于空：返回0。
  定总和=求和列表。
  定数量=长列表。
  除总和数量。
．

-- 中位数
定中位数=函列表：
  当列表等于空：返回0。
  定排序列表=排序列表函a b a小于b。
  定长度=长排序列表。
  当长度模2等于1：返回入排序列表除长度2。当0等于0：返回空。定左=入排序列表减下取整除长度2。当右=入排序列表减下取整除长度2。返回除加左右2。
．

-- 方差
定方差=函列表：
  当列表等于空：返回0。
  定平均=平均值列表。
  定平方差=列。
  定i=0。当i小于长列表：定元素=入列表i。连平方差列幂减元素平均2。i=加i1。返回平均值平方差。
．

-- 标准差
定标准差=函列表：{{ math.sqrt(方差(列表)) }}。

-- 最大公约数
定最大公约数=函ab：
  {{ math.gcd(a, b) }}
．

-- 最小公倍数
定最小公倍数=函ab：
  定g=最大公约数ab。
  除乘abg。
．

-- 阶乘
定阶乘=函n：
  当n小于等于1：返回1。
  定结果=1。定i=2。当i小于等于n：定结果=乘结果i。i=加i1。返回结果。
．

-- 判断是否为素数
定是素数=函n：
  当n小于2：返回假。
  当n等于2：返回真。
  当n模2等于0：返回假。
  定i=3。
  当i乘i小于等于n：
    当n模i等于0：返回假。。i=加i2。
  。返回真。
．

-- 生成素数列表
定素数列表=函n：
  定结果=列。定i=2。当i小于等于n：
    当是素数i：连结果列i。。i=加1。
  。返回结果。
．

-- 斐波那契数列
定斐波那契=函n：
  当n小于等于0：返回0。
  当n等于1：返回1。
  定a=0。定b=1。定i=2。当i小于等于n：
    定c=加ab。定a=b。定b=c。i=加i1。返回b。
．

-- 随机整数
定随机整数=函最小最大：
  {{ random.randint(min, max) }}
．

-- 随机小数
定随机小数=函：{{ random.random() }}。

-- 随机选择
定随机选择=函列表：
  当列表等于空：返回空。
  {{ random.choice(list) }}
．

-- 打乱列表
定打乱=函列表：
  定副本=列。定i=长副本。当i大于1：
    定j=随机整数0减i1。
    定tmp=副本i。当副本j：定副本=副本itmp。定副本=副本jt。
    i=减i1。
  。返回副本。
．

-- 角度转弧度
定角度弧度=函角度：{{ angle * π / 180 }}。

-- 弧度转角度
定弧度角度=函弧度：{{ rad * 180 / π }}。
