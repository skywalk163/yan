-- 进程管理模块（process.yan）
-- 提供进程和系统命令执行功能

-- 导出声明
出 执行命令, 获取输出, 获取错误, 获取返回码,
    获取环境变量, 设置环境变量, 获取所有环境变量,
    启动进程, 运行命令,
    执行Python, 执行Shell,
    目录列表, 当前路径, 改变目录,
    创建目录, 删除目录,
    文件大小, 文件修改时间,
    复制文件, 移动文件, 删除文件,
    获取PID, 获取用户名, 获取主机名。

-- 执行系统命令
定 执行命令 = 函 命令：
  返回 执行命令 命令。
．

-- 获取命令输出
定 获取输出 = 函 命令：
  定 结果 = 执行命令 命令。
  返回 值 结果 "stdout"。
．

-- 获取命令错误输出
定 获取错误 = 函 命令：
  定 结果 = 执行命令 命令。
  返回 值 结果 "stderr"。
．

-- 获取命令返回码
定 获取返回码 = 函 命令：
  定 结果 = 执行命令 命令。
  返回 值 结果 "returncode"。
．

-- 获取环境变量
定 获取环境变量 = 函 名称：
  返回 获取环境变量 名称。
．

-- 设置环境变量
定 设置环境变量 = 函 名称 值：
  设置环境变量 名称 值。
．

-- 获取所有环境变量
定 获取所有环境变量 = 函：
  返回 获取所有环境变量。
．

-- 启动进程（异步）
定 启动进程 = 函 命令：
  返回 启动进程 命令。
．

-- 运行命令（同步）
定 运行命令 = 函 命令：
  定 结果 = 执行命令 命令。
  当 等于 值 结果 "returncode" 0：
    返回 值 结果 "stdout"。
  。
  返回 值 结果 "stderr"。
．

-- 执行Python代码
定 执行Python = 函 代码：
  定 命令 = 连 "python -c \"" 代码 "\""。
  返回 运行命令 命令。
．

-- 执行Shell脚本
定 执行Shell = 函 脚本：
  返回 运行命令 脚本。
．

-- 列出目录内容
定 目录列表 = 函 路径：
  返回 列目录 路径。
．

-- 获取当前路径
定 当前路径 = 函：
  返回 当前目录。
．

-- 改变当前目录
定 改变目录 = 函 路径：
  无。
．

-- 创建目录
定 创建目录 = 函 路径：
  建目录 路径。
．

-- 删除目录
定 删除目录 = 函 路径：
  删目录 路径。
．

-- 获取文件大小
定 文件大小 = 函 路径：
  当 不是文件 路径：
    返回 0。
  。
  返回 0。
．

-- 获取文件修改时间
定 文件修改时间 = 函 路径：
  返回 当前时间戳。
．

-- 复制文件
定 复制文件 = 函 源 目标：
  定 内容 = 读文件 源。
  写文件 目标 内容。
．

-- 移动文件
定 移动文件 = 函 源 目标：
  复制文件 源 目标。
  删除文件 源。
．

-- 删除文件
定 删除文件 = 函 路径：
  删文件 路径。
．

-- 获取当前进程ID
定 获取PID = 函：
  定 结果 = 获取环境变量 "PID"。
  当 结果 不等于 空串：
    返回 转数字 结果。
  。
  返回 0。
．

-- 获取当前用户名
定 获取用户名 = 函：
  返回 获取环境变量 "USER"。
．

-- 获取主机名
定 获取主机名 = 函：
  返回 获取环境变量 "HOSTNAME"。
．