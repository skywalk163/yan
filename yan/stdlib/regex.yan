-- 正则表达式模块（regex.yan）
-- 提供正则表达式匹配和处理功能

-- 导出声明
出 匹配, 搜索, 查找所有, 替换, 分割, 完全匹配,
    编译, 匹配对象, 分组, 捕获组, 命名组,
    匹配位置, 替换回调, 子模式,
    验证邮箱, 验证手机号, 验证URL, 验证IP,
    提取数字, 提取单词, 提取HTML标签。

-- 匹配开头
定 匹配 = 函 模式 文本：
  返回 正则匹配 模式 文本。
．

-- 搜索任意位置
定 搜索 = 函 模式 文本：
  返回 正则搜索 模式 文本。
．

-- 查找所有匹配
定 查找所有 = 函 模式 文本：
  返回 正则查找所有 模式 文本。
．

-- 替换匹配内容
定 替换 = 函 模式 替换文本 文本：
  返回 正则替换 模式 替换文本 文本。
．

-- 按模式分割
定 分割 = 函 模式 文本：
  返回 正则分割 模式 文本。
．

-- 完全匹配
定 完全匹配 = 函 模式 文本：
  返回 正则完全匹配 模式 文本。
．

-- 编译正则表达式
定 编译 = 函 模式：
  返回 正则编译 模式。
．

-- 创建匹配对象
定 匹配对象 = 函 模式 文本：
  定 结果 = 查找所有 模式 文本。
  当 长 结果 大于 0：
    返回 取 结果 0。
  。
  返回 空。
．

-- 获取分组内容
定 分组 = 函 模式 文本 组索引：
  定 匹配 = 搜索 模式 文本。
  当 匹配 不等于 空：
    返回 匹配。
  。
  返回 空。
．

-- 获取所有捕获组
定 捕获组 = 函 模式 文本：
  定 结果 = 查找所有 模式 文本。
  返回 结果。
．

-- 获取命名组
定 命名组 = 函 模式 文本 组名：
  定 匹配 = 搜索 模式 文本。
  当 匹配 不等于 空：
    返回 匹配。
  。
  返回 空。
．

-- 获取匹配位置
定 匹配位置 = 函 模式 文本：
  定 结果 = 查找所有 模式 文本。
  定 位置 = 列。
  定 i = 0。
  当 i 小于 长 结果：
    定 匹配 = 取 结果 i。
    定 开始 = 查找 文本 匹配。
    定 结束 = 加 开始 长 匹配。
    添 位置 典 "开始" 开始 "结束" 结束 "匹配" 匹配。
    定 i = 加 i 1。
  。
  返回 位置。
．

-- 替换（带回调）
定 替换回调 = 函 模式 文本 回调函数：
  定 匹配列表 = 查找所有 模式 文本。
  定 结果 = 文本。
  定 i = 长 匹配列表。
  当 i 大于 0：
    定 i = 减 i 1。
    定 匹配 = 取 匹配列表 i。
    定 替换值 = 回调函数 匹配。
    定 结果 = 替换 匹配 替换值 结果。
  。
  返回 结果。
．

-- 获取子模式
定 子模式 = 函 模式 文本 索引：
  定 结果 = 查找所有 模式 文本。
  当 且 大于 索引 负 1 小于 索引 长 结果：
    返回 取 结果 索引。
  。
  返回 空。
．

-- 验证邮箱格式
定 验证邮箱 = 函 文本：
  定 模式 = r'^[\w\.-]+@[\w\.-]+\.\w+$'。
  定 结果 = 完全匹配 模式 文本。
  当 结果 不等于 空：
    返回 真。
  。
  返回 假。
．

-- 验证手机号（中国大陆）
定 验证手机号 = 函 文本：
  定 模式 = r'^1[3-9]\d{9}$'。
  定 结果 = 完全匹配 模式 文本。
  当 结果 不等于 空：
    返回 真。
  。
  返回 假。
．

-- 验证URL
定 验证URL = 函 文本：
  定 模式 = r'^https?://[\w\.-]+(?:/[\w\.-]*)*$'。
  定 结果 = 完全匹配 模式 文本。
  当 结果 不等于 空：
    返回 真。
  。
  返回 假。
．

-- 验证IP地址
定 验证IP = 函 文本：
  定 模式 = r'^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$'。
  定 结果 = 完全匹配 模式 文本。
  当 结果 不等于 空：
    返回 真。
  。
  返回 假。
．

-- 提取所有数字
定 提取数字 = 函 文本：
  定 模式 = r'\d+'。
  返回 查找所有 模式 文本。
．

-- 提取所有单词
定 提取单词 = 函 文本：
  定 模式 = r'\w+'。
  返回 查找所有 模式 文本。
．

-- 提取HTML标签
定 提取HTML标签 = 函 文本：
  定 模式 = r'<[^>]+>'。
  返回 查找所有 模式 文本。
．