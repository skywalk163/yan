-- 字符串模块（string.yan）
-- 提供字符串处理功能

-- 导出声明
出 长度, 重复, 大写, 小写, 首字母大写,
    去空白, 去左空白, 去右空白,
    替换, 替换N, 查找, 右查找,
    包含?, 开头?, 结尾?,
    分割, 按空白分割, 分割行, 连接,
    子串, 取字符,
    转数字, 转字符串,
    统计, 居中, 左对齐, 右对齐, 补零,
    是数字?, 是字母?, 是字母数字?, 是空白?, 是标题?,
    转标题, 反转, 转义, 取消转义,
    格式, 格式数字, 比较

-- 字符串长度
定 长度 = 函 str：
  返回 长度 str


-- 重复字符串
定 重复 = 函 str times：
  定 结果 = 空串
  定 i = 0
  当 i 小于 times：
    定 结果 = 连 结果 str
    定 i = 加 i 1

  返回 结果


-- 转大写
定 大写 = 函 str：
  返回 大写 str


-- 转小写
定 小写 = 函 str：
  返回 小写 str


-- 首字母大写
定 首字母大写 = 函 str：
  当 长 str 小于 1：
    返回 str

  定 首字符 = 大写 取字符 str 0
  定 其余 = 小写 子串 str 1 长 str
  返回 连 首字符 其余


-- 去除首尾空白
定 去空白 = 函 str：
  返回 去空 str


-- 去除左边空白
定 去左空白 = 函 str：
  定 i = 0
  当 i 小于 长 str：
    定 c = 取字符 str i
    当 非 或 等于 c " " 等于 c "\\t" 等于 c "\\n" 等于 c "\\r"：
      跳出

    定 i = 加 i 1

  返回 子串 str i 长 str


-- 去除右边空白
定 去右空白 = 函 str：
  定 i = 长 str
  当 i 大于 0：
    定 c = 取字符 str 减 i 1
    当 非 或 等于 c " " 等于 c "\\t" 等于 c "\\n" 等于 c "\\r"：
      跳出

    定 i = 减 i 1

  返回 子串 str 0 i


-- 替换字符串
定 替换 = 函 str old new：
  返回 替换 str old new


-- 替换字符串（限制次数）
定 替换N = 函 str old new count：
  定 结果 = 空串
  定 位置 = 查找 str old
  定 计数 = 0
  定 起始 = 0
  当 且 大于 位置 负 1 小于 计数 count：
    定 结果 = 连 结果 子串 str 起始 位置 新
    定 起始 = 加 位置 长 old
    定 位置 = 查找 str old 起始
    定 计数 = 加 计数 1

  定 结果 = 连 结果 子串 str 起始 长 str
  返回 结果


-- 查找子字符串
定 查找 = 函 str substr：
  返回 查找 str substr


-- 从右边查找子字符串
定 右查找 = 函 str substr：
  定 结果 = 负 1
  定 子长度 = 长 substr
  定 最大 = 减 长 str 子长度
  定 i = 0
  当 i 小于等于 最大：
    定 当前 = 子串 str i 加 i 子长度
    当 等于 当前 substr：
      定 结果 = i

    定 i = 加 i 1

  返回 结果


-- 检查是否包含子字符串
定 包含? = 函 str substr：
  返回 包含 str substr


-- 检查是否以指定字符串开头
定 开头? = 函 str prefix：
  返回 开头是 str prefix


-- 检查是否以指定字符串结尾
定 结尾? = 函 str suffix：
  返回 结尾是 str suffix


-- 分割字符串
定 分割 = 函 str separator：
  返回 分割 str separator


-- 按空白分割
定 按空白分割 = 函 str：
  定 结果 = 列
  定 当前 = 空串
  定 i = 0
  当 i 小于 长 str：
    定 c = 取字符 str i
    当 或 等于 c " " 等于 c "\\t" 等于 c "\\n" 等于 c "\\r"：
      当 长 当前 大于 0：
        添 结果 当前
        定 当前 = 空串


    否则：
      定 当前 = 连 当前 c

    定 i = 加 i 1

  当 长 当前 大于 0：
    添 结果 当前

  返回 结果


-- 按行分割
定 分割行 = 函 str：
  定 结果 = 分割 str "\\n"
  定 最后 = 取 结果 减 长 结果 1
  当 结尾是 最后 "\\r"：
    设 结果 减 长 结果 1 子串 最后 0 减 长 最后 1

  返回 结果


-- 连接列表
定 连接 = 函 separator strlist：
  定 结果 = 空串
  定 i = 0
  当 i 小于 长 strlist：
    当 i 大于 0：
      定 结果 = 连 结果 separator

    定 结果 = 连 结果 取 strlist i
    定 i = 加 i 1

  返回 结果


-- 截取子串
定 子串 = 函 str start end：
  返回 截取 str start end


-- 获取单个字符
定 取字符 = 函 str index：
  返回 取 str index


-- 字符串转数字
定 转数字 = 函 str：
  定 点计数 = 0
  定 i = 0
  当 i 小于 长 str：
    定 c = 取字符 str i
    当 等于 c "."：
      定 点计数 = 加 点计数 1

    当 非 或 是数字? c 等于 c "."：
      返回 空

    定 i = 加 i 1

  当 等于 点计数 0：
    定 结果 = 0
    定 i = 0
    当 i 小于 长 str：
      定 结果 = 加 乘 结果 10 减 取字符 str i "0"
      定 i = 加 i 1

    返回 结果

  当 等于 点计数 1：
    定 整数部分 = 0
    定 小数部分 = 0
    定 小数位数 = 0
    定 点位置 = 查找 str "."
    定 i = 0
    当 i 小于 点位置：
      定 整数部分 = 加 乘 整数部分 10 减 取字符 str i "0"
      定 i = 加 i 1

    定 i = 加 点位置 1
    当 i 小于 长 str：
      定 小数部分 = 加 乘 小数部分 10 减 取字符 str i "0"
      定 小数位数 = 加 小数位数 1
      定 i = 加 i 1

    定 乘数 = 幂 10 小数位数
    返回 加 整数部分 除 小数部分 乘数

  返回 空


-- 数字转字符串
定 转字符串 = 函 num：
  当 是表 num：
    定 结果 = "["
    定 i = 0
    当 i 小于 长 num：
      当 i 大于 0：
        定 结果 = 连 结果 ", "

      定 结果 = 连 结果 转字符串 取 num i
      定 i = 加 i 1

    返回 连 结果 "]"

  当 是真 num：
    返回 "真"

  当 是空 num：
    返回 "空"

  定 结果 = 空串
  定 负数 = 假
  当 num 小于 0：
    定 负数 = 真
    定 num = 负 num

  当 是数 num：
    定 整数部分 = 下取整 num
    定 小数部分 = 减 num 整数部分
    定 i = 0
    当 整数部分 大于 0：
      定 结果 = 连 取字符 连 "0123456789" 模 整数部分 10 结果
      定 整数部分 = 除 整数部分 10

    当 等于 长 结果 0：
      定 结果 = "0"

    当 小数部分 大于 0：
      定 结果 = 连 结果 "."
      定 i = 0
      当 i 小于 10：
        定 小数部分 = 乘 小数部分 10
        定 数字 = 下取整 小数部分
        定 结果 = 连 结果 取字符 "0123456789" 数字
        定 小数部分 = 减 小数部分 数字
        定 i = 加 i 1



  当 负数：
    返回 连 "-" 结果

  返回 结果


-- 统计子字符串出现次数
定 统计 = 函 str substr：
  定 计数 = 0
  定 位置 = 查找 str substr
  当 大于 位置 负 1：
    定 计数 = 加 计数 1
    定 位置 = 查找 str substr 加 位置 长 substr

  返回 计数


-- 居中对齐
定 居中 = 函 str width fillchar：
  当 fillchar 等于 空：
    定 fillchar = " "

  定 空格数 = 减 width 长 str
  当 空格数 小于 0：
    返回 str

  定 左空格 = 除 空格数 2
  定 右空格 = 减 空格数 左空格
  返回 连 重复 fillchar 左空格 str 重复 fillchar 右空格


-- 左对齐
定 左对齐 = 函 str width fillchar：
  当 fillchar 等于 空：
    定 fillchar = " "

  定 空格数 = 减 width 长 str
  当 空格数 小于 0：
    返回 str

  返回 连 str 重复 fillchar 空格数


-- 右对齐
定 右对齐 = 函 str width fillchar：
  当 fillchar 等于 空：
    定 fillchar = " "

  定 空格数 = 减 width 长 str
  当 空格数 小于 0：
    返回 str

  返回 连 重复 fillchar 空格数 str


-- 补零
定 补零 = 函 str width：
  定 空格数 = 减 width 长 str
  当 空格数 小于 0：
    返回 str

  返回 连 重复 "0" 空格数 str


-- 检查是否为数字
定 是数字? = 函 str：
  当 长 str 等于 0：
    返回 假

  定 i = 0
  当 i 小于 长 str：
    定 c = 取字符 str i
    当 非 含 "0123456789" c：
      返回 假

    定 i = 加 i 1

  返回 真


-- 检查是否为字母
定 是字母? = 函 str：
  当 长 str 等于 0：
    返回 假

  定 i = 0
  当 i 小于 长 str：
    定 c = 取字符 str i
    当 非 或 含 "abcdefghijklmnopqrstuvwxyz" 小写 c 含 "ABCDEFGHIJKLMNOPQRSTUVWXYZ" 大写 c：
      返回 假

    定 i = 加 i 1

  返回 真


-- 检查是否为字母数字
定 是字母数字? = 函 str：
  当 长 str 等于 0：
    返回 假

  定 i = 0
  当 i 小于 长 str：
    定 c = 取字符 str i
    当 非 或 含 "0123456789" c 含 "abcdefghijklmnopqrstuvwxyz" 小写 c 含 "ABCDEFGHIJKLMNOPQRSTUVWXYZ" 大写 c：
      返回 假

    定 i = 加 i 1

  返回 真


-- 检查是否为空白
定 是空白? = 函 str：
  定 i = 0
  当 i 小于 长 str：
    定 c = 取字符 str i
    当 非 或 等于 c " " 等于 c "\\t" 等于 c "\\n" 等于 c "\\r"：
      返回 假

    定 i = 加 i 1

  返回 真


-- 检查是否为标题格式
定 是标题? = 函 str：
  定 单词 = 按空白分割 str
  定 i = 0
  当 i 小于 长 单词：
    定 词 = 取 单词 i
    当 长 词 大于 0：
      定 首字符 = 取字符 词 0
      当 非 含 "ABCDEFGHIJKLMNOPQRSTUVWXYZ" 首字符：
        返回 假


    定 i = 加 i 1

  返回 真


-- 转换为标题格式
定 转标题 = 函 str：
  定 单词 = 按空白分割 str
  定 结果 = 列
  定 i = 0
  当 i 小于 长 单词：
    定 词 = 取 单词 i
    当 长 词 大于 0：
      定 首字符 = 大写 取字符 词 0
      定 其余 = 小写 子串 词 1 长 词
      添 结果 连 首字符 其余

    定 i = 加 i 1

  返回 连接 " " 结果


-- 反转字符串
定 反转 = 函 str：
  定 结果 = 空串
  定 i = 长 str
  当 i 大于 0：
    定 i = 减 i 1
    定 结果 = 连 结果 取字符 str i

  返回 结果


-- 转义字符串
定 转义 = 函 str：
  定 结果 = str
  定 结果 = 替换 结果 "\\" "\\\\"
  定 结果 = 替换 结果 "\"" "\\\""
  定 结果 = 替换 结果 "\\n" "\\n"
  定 结果 = 替换 结果 "\\t" "\\t"
  返回 结果


-- 取消转义
定 取消转义 = 函 str：
  定 结果 = str
  定 结果 = 替换 结果 "\\n" "\\n"
  定 结果 = 替换 结果 "\\t" "\\t"
  定 结果 = 替换 结果 "\\\"" "\""
  定 结果 = 替换 结果 "\\\\" "\\"
  返回 结果


-- 格式化字符串
定 格式 = 函 template ...：
  定 参数 = 列
  定 i = 1
  当 i 小于 长 列 template ...：
    添 参数 取 列 template ... i
    定 i = 加 i 1

  定 结果 = template
  定 i = 0
  当 i 小于 长 参数：
    定 占位符 = 连 "{" i "}"
    定 结果 = 替换 结果 占位符 转字符串 取 参数 i
    定 i = 加 i 1

  返回 结果


-- 格式化数字
定 格式数字 = 函 num fmt：
  返回 转字符串 num


-- 比较字符串
定 比较 = 函 a b：
  当 a 大于 b：
    返回 1

  当 a 小于 b：
    返回 负 1

  返回 0
