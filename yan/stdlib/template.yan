-- 模板引擎模块（template.yan）
-- 提供模板渲染功能

-- 导出声明
出 渲染, 加载模板, 渲染文件, 渲染包含。

定 渲染变量 = 函 模板 数据：
  定 模式 = r'\{\{(\w+)\}\}'
  定 匹配 = 查找所有 模式 模板
  定 结果 = 模板
  定 i = 0
  当 i 小于 长 匹配：
    定 匹配项 = 取 匹配 i
    定 变量名 = 取 匹配项 1
    定 值 = 空
    当 存在键 数据 变量名：
      设 值 值 数据 变量名

    定 替换字符串 = 连 "{{" 变量名 "}}"
    设 结果 替换 结果 替换字符串 转字符串 值
    定 i = 加 i 1

  返回 结果
.

定 渲染条件 = 函 模板 数据：
  定 模式 = r'\{% if (\w+) %\}(.*?)\{% endif %\}'
  定 结果 = 模板
  定 匹配 = 查找所有 模式 结果
  定 i = 0
  当 i 小于 长 匹配：
    定 匹配项 = 取 匹配 i
    定 条件变量 = 取 匹配项 1
    定 内容 = 取 匹配项 2
    定 条件值 = 假
    当 存在键 数据 条件变量：
      设 条件值 值 数据 条件变量

    定 替换字符串 = 连 "{% if " 条件变量 " %}" 内容 "{% endif %}"
    当 条件值：
      设 结果 替换 结果 替换字符串 内容
    否则：
      设 结果 替换 结果 替换字符串 ""

    定 i = 加 i 1

  返回 结果
.

定 渲染循环 = 函 模板 数据：
  定 模式 = r'\{% for (\w+) in (\w+) %\}(.*?)\{% endfor %\}'
  定 结果 = 模板
  定 匹配 = 查找所有 模式 结果
  定 i = 0
  当 i 小于 长 匹配：
    定 匹配项 = 取 匹配 i
    定 变量名 = 取 匹配项 1
    定 列表名 = 取 匹配项 2
    定 内容 = 取 匹配项 3
    定 列表值 = 空
    当 存在键 数据 列表名：
      设 列表值 值 数据 列表名

    定 替换字符串 = 连 "{% for " 变量名 " in " 列表名 " %}" 内容 "{% endfor %}"
    定 输出 = ""
    定 j = 0
    当 j 小于 长 列表值：
      定 项 = 取 列表值 j
      定 临时数据 = 复制 数据
      设 临时数据 变量名 项
      定 渲染项 = 渲染变量 内容 临时数据
      设 输出 连 输出 渲染项
      定 j = 加 j 1

    设 结果 替换 结果 替换字符串 输出
    定 i = 加 i 1

  返回 结果
.

定 渲染包含 = 函 模板：
  定 模式 = r'\{% include "([^"]+)" %\}'
  定 匹配 = 查找所有 模式 模板
  定 结果 = 模板
  定 i = 0
  当 i 小于 长 匹配：
    定 匹配项 = 取 匹配 i
    定 文件名 = 取 匹配项 1
    定 内容 = 加载模板 文件名
    当 内容 不等于 空：
      定 替换字符串 = 取 匹配项 0
      设 结果 替换 结果 替换字符串 内容

    定 i = 加 i 1

  返回 结果
.

定 渲染继承 = 函 模板 数据：
  -- 查找是否有基础模板定义
  定 基础模式 = r'\{% extends "([^"]+)" %\}'
  定 基础匹配 = 搜索 基础模式 模板
  当 基础匹配 不等于 空：
    定 基础文件名 = 取 基础匹配 1
    定 基础模板 = 加载模板 基础文件名
    当 基础模板 不等于 空：
      -- 用内容替换 {% block %}...{% endblock %}
      定 块模式 = r'\{% block (\w+) %\}(.*?)\{% endblock %\}'
      定 块匹配 = 查找所有 块模式 模板
      定 结果 = 基础模板
      定 i = 0
      当 i 小于 长 块匹配：
        定 块名 = 取 (取 块匹配 i) 1
        定 块内容 = 取 (取 块匹配 i) 2
        定 替换目标 = 连 "{% block " 块名 " %}" (取 (取 块匹配 i) 0) "{% endblock %}"
        设 结果 替换 结果 替换目标 块内容
        定 i = 加 i 1

      返回 结果


  返回 模板
.

定 渲染 = 函 模板 数据：
  当 数据 等于 空：
    设 数据 典

  定 结果 = 模板
  -- 先处理继承
  设 结果 渲染继承 结果 数据
  -- 处理包含
  设 结果 渲染包含 结果
  -- 处理循环
  设 结果 渲染循环 结果 数据
  -- 处理条件
  设 结果 渲染条件 结果 数据
  -- 处理变量
  设 结果 渲染变量 结果 数据
  返回 结果
.

定 加载模板 = 函 文件名：
  当 存在文件 文件名：
    返回 读文件 文件名

  返回 空
.

定 渲染文件 = 函 文件名 数据：
  定 模板 = 加载模板 文件名
  当 模板 不等于 空：
    返回 渲染 模板 数据

  返回 空
.
