-- 时间处理模块（time.yan）
-- 提供时间和日期处理函数

-- 导出声明
出 当前时间戳, 当前时间, 当前日期时间, 当前日期, 当前时间字符串,
    格式化时间, 解析时间, 时间戳日期, 日期时间戳,
    取年, 取月, 取日, 取时, 取分, 取秒,
    星期几, 时间差秒, 时间差天, 时间差小时, 时间差分钟,
    睡眠, 睡眠毫秒, 生时间戳, 是闰年, 月天数, 是有效日期,
    中文星期名, 中文月名。

-- 获取当前时间戳
定 当前时间戳 = 函：{{ time.time() }}。

-- 获取当前时间
定 当前时间 = 函：{{ time.time() }}。

-- 获取当前日期时间
定 当前日期时间 = 函：{{ get_current_datetime() }}。

-- 获取当前日期
定 当前日期 = 函：{{ get_current_date() }}。

-- 获取当前时间字符串
定 当前时间字符串 = 函 格式化：
  当 格式化 等于 空：定 格式化 = "%Y-%m-%d %H:%M:%S"。
  {{ format_time(format) }}
．

-- 格式化时间
定 格式化时间 = 函 时间戳 格式化：
  当 格式化 等于 空：定 格式化 = "%Y-%m-%d %H:%M:%S"。
  {{ format_timestamp(timestamp, format) }}
．

-- 解析时间字符串
定 解析时间 = 函 时间字符串 格式化：
  当 格式化 等于 空：定 格式化 = "%Y-%m-%d %H:%M:%S"。
  {{ parse_time(time_str, format) }}
．

-- 时间戳转日期
定 时间戳日期 = 函 时间戳：{{ timestamp_to_date(timestamp) }}。

-- 日期转时间戳
定 日期时间戳 = 函 日期字符串：{{ date_to_timestamp(date_str) }}。

-- 获取年
定 取年 = 函 日期：{{ get_year(date) }}。

-- 获取月
定 取月 = 函 日期：{{ get_month(date) }}。

-- 获取日
定 取日 = 函 日期：{{ get_day(date) }}。

-- 获取时
定 取时 = 函 时间：{{ get_hour(time) }}。

-- 获取分
定 取分 = 函 时间：{{ get_minute(time) }}。

-- 获取秒
定 取秒 = 函 时间：{{ get_second(time) }}。

-- 获取星期几
定 星期几 = 函 日期：{{ get_weekday(date) }}。

-- 时间差（秒）
定 时间差秒 = 函 结束 开始：{{ (end - start).total_seconds() }}。

-- 时间差（天）
定 时间差天 = 函 结束 开始：{{ (end - start).days }}。

-- 时间差（小时）
定 时间差小时 = 函 结束 开始：{{ (end - start).total_seconds() / 3600 }}。

-- 时间差（分钟）
定 时间差分钟 = 函 结束 开始：{{ (end - start).total_seconds() / 60 }}。

-- 睡眠（秒）
定 睡眠 = 函 秒数：{{ time.sleep(seconds) }}。

-- 睡眠（毫秒）
定 睡眠毫秒 = 函 毫秒：{{ time.sleep(milliseconds / 1000) }}。

-- 生成时间戳
定 生时间戳 = 函 年 月 日 时 分 秒：
  当 月 等于 空：定 月 = 1。。
  当 日 等于 空：定 日 = 1。。
  当 时 等于 空：定 时 = 0。。
  当 分 等于 空：定 分 = 0。。
  当 秒 等于 空：定 秒 = 0。。
  {{ make_timestamp(year, month, day, hour, minute, second) }}
．

-- 判断是否为闰年
定 是闰年 = 函 年：{{ year % 4 == 0 and (year % 100 != 0 or year % 400 == 0) }}。

-- 获取某月的天数
定 月天数 = 函 年 月：
  当 或 月 等于 1 月 等于 3 月 等于 5 月 等于 7 月 等于 8 月 等于 10 月 等于 12：返回 31。。
  当 或 月 等于 4 月 等于 6 月 等于 9 月 等于 11：返回 30。。
  当 是闰年 年：返回 29。。
  返回 28。
．

-- 判断是否为有效日期
定 是有效日期 = 函 年 月 日：
  当 或 年 小于 1 月 小于 1 日 小于 1：返回 假。。
  当 月 大于 12：返回 假。。
  当 日 大于 月天数 年 月：返回 假。。
  返回 真。
．

-- 获取中文星期名称
定 中文星期名 = 函 星期几：
  定 名称 = 列 "星期一" "星期二" "星期三" "星期四" "星期五" "星期六" "星期日"。
  当 星期几 大于等于 0 且 星期几 小于 7：返回 入 名称 星期几。。
  返回 "未知"。
．

-- 获取中文月份名称
定 中文月名 = 函 月：
  定 名称 = 列 "一月" "二月" "三月" "四月" "五月" "六月" "七月" "八月" "九月" "十月" "十一月" "十二月"。
  当 月 大于等于 1 且 月 小于等于 12：返回 入 名称 减 月 1。。
  返回 "未知"。
．