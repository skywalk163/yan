-- 时间模块（time.yan）
-- 提供时间和日期处理功能

-- 导出声明
出 当前时间戳, 当前时间, 当前日期时间, 当前日期,
    格式化时间, 格式化时间戳, 解析时间,
    时间戳日期, 日期时间戳,
    取年, 取月, 取日, 取时, 取分, 取秒,
    星期几,
    时间差秒, 时间差天, 时间差小时, 时间差分钟,
    睡眠, 睡眠毫秒,
    生成时间戳,
    是闰年

-- 获取当前时间戳
定 当前时间戳 = 函：
  返回 当前时间


-- 获取当前时间（时间戳）
定 当前时间 = 函：
  返回 当前时间


-- 获取当前日期时间字符串
定 当前日期时间 = 函：
  返回 日期时间


-- 获取当前日期字符串
定 当前日期 = 函：
  返回 日期


-- 格式化时间
定 格式化时间 = 函 格式：
  返回 格式化时间 格式 空


-- 格式化时间戳
定 格式化时间戳 = 函 时间戳 格式：
  返回 格式化时间 格式 时间戳


-- 解析时间字符串
定 解析时间 = 函 时间字符串 格式：
  返回 日期时间戳 连 时间字符串 " 00:00:00"


-- 时间戳转日期
定 时间戳日期 = 函 时间戳：
  返回 时间戳日期 时间戳


-- 日期转时间戳
定 日期时间戳 = 函 日期字符串：
  返回 日期时间戳 日期字符串


-- 获取年份
定 取年 = 函 日期：
  返回 取年 日期


-- 获取月份
定 取月 = 函 日期：
  返回 取月 日期


-- 获取日期
定 取日 = 函 日期：
  返回 取日 日期


-- 获取小时
定 取时 = 函 时间：
  返回 取时 时间


-- 获取分钟
定 取分 = 函 时间：
  返回 取分 时间


-- 获取秒
定 取秒 = 函 时间：
  返回 取秒 时间


-- 获取星期几
定 星期几 = 函 日期：
  返回 星期几 日期


-- 计算时间差（秒）
定 时间差秒 = 函 结束 开始：
  返回 减 结束 开始


-- 计算时间差（天）
定 时间差天 = 函 结束 开始：
  返回 除 减 结束 开始 86400


-- 计算时间差（小时）
定 时间差小时 = 函 结束 开始：
  返回 除 减 结束 开始 3600


-- 计算时间差（分钟）
定 时间差分钟 = 函 结束 开始：
  返回 除 减 结束 开始 60


-- 睡眠（秒）
定 睡眠 = 函 秒数：
  睡眠 秒数


-- 睡眠（毫秒）
定 睡眠毫秒 = 函 毫秒：
  睡眠毫秒 毫秒


-- 根据年月日时分秒生成时间戳
定 生成时间戳 = 函 年 月 日 时 分 秒：
  定 日期字符串 = 连 年 "-" 月 "-" 日 " " 时 ":" 分 ":" 秒
  返回 日期时间戳 日期字符串


-- 判断是否为闰年
定 是闰年 = 函 年：
  返回 是闰年 年
