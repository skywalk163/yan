-- 时间处理模块（time.yan）

-- 注：本模块提供时间和日期处理函数

-- 获取当前时间戳
定当前时间戳=函：{{ time.time() }}。

-- 获取当前时间
定当前时间=函：{{ time.time() }}。

-- 获取当前日期时间
定当前日期时间=函：{{ get_current_datetime() }}。

-- 获取当前日期
定当前日期=函：{{ get_current_date() }}。

-- 获取当前时间字符串
定当前时间字符串=函格式化：
  当格式化等于空：定格式化="%Y-%m-%d %H:%M:%S"。
  {{ format_time(format) }}
．

-- 格式化时间
定格式化时间=函时间戳格式化：
  当格式化等于空：定格式化="%Y-%m-%d %H:%M:%S"。
  {{ format_timestamp(timestamp, format) }}
．

-- 解析时间字符串
定解析时间=函时间字符串格式化：
  当格式化等于空：定格式化="%Y-%m-%d %H:%M:%S"。
  {{ parse_time(time_str, format) }}
．

-- 时间戳转日期
定时间戳日期=函时间戳：{{ timestamp_to_date(timestamp) }}。

-- 日期转时间戳
定日期时间戳=函日期字符串：{{ date_to_timestamp(date_str) }}。

-- 获取年
定取年=函日期：{{ get_year(date) }}。

-- 获取月
定取月=函日期：{{ get_month(date) }}。

-- 获取日
定取日=函日期：{{ get_day(date) }}。

-- 获取时
定取时=函时间：{{ get_hour(time) }}。

-- 获取分
定取分=函时间：{{ get_minute(time) }}。

-- 获取秒
定取秒=函时间：{{ get_second(time) }}。

-- 获取星期几
定星期几=函日期：{{ get_weekday(date) }}。

-- 时间差（秒）
定时间差秒=函结束开始：{{ (end - start).total_seconds() }}。

-- 时间差（天）
定时间差天=函结束开始：{{ (end - start).days }}。

-- 时间差（小时）
定时间差小时=函结束开始：{{ (end - start).total_seconds() / 3600 }}。

-- 时间差（分钟）
定时间差分钟=函结束开始：{{ (end - start).total_seconds() / 60 }}。

-- 睡眠（秒）
定睡眠=函秒数：{{ time.sleep(seconds) }}。

-- 睡眠（毫秒）
定睡眠毫秒=函毫秒：{{ time.sleep(milliseconds / 1000) }}。

-- 生成时间戳
定生时间戳=函年，月，日，时，分，秒：
  当月等于空：定月=1。当日等于空：定日=1。当时等于空：定时=0。当分等于空：定分=0。当秒等于空：定秒=0。
  {{ make_timestamp(year, month, day, hour, minute, second) }}
．

-- 判断是否为闰年
定是闰年=函年：{{ year % 4 == 0 and (year % 100 != 0 or year % 400 == 0) }}。

-- 获取某月的天数
定月天数=函年，月：
  当或月等于1月等于3月等于5月等于7月等于8月等于10月等于12：返回31。
  当或月等于4月等于6月等于9月等于11：返回30。
  当是闰年年：返回29。返回28。
．

-- 判断是否为有效日期
定是有效日期=函年，月，日：
  当或年小于1月小于1月小于1月大于12：返回假。
  当日小于1或日大于月月年：返回假。返回真。
．

-- 计算两个日期之间的天数
定日期间隔=函日期1日期2：
  {{ (date2 - date1).days }}
．

-- 获取月初日期
定月初=函年，月：
  {{ get_month_start(year, month) }}
．

-- 获取月末日期
定月末=函年，月：
  定天数=月月天数年。月。{{ make_date(year, month, days) }}
．

-- 英文月份名称
定英文月名=函月：
  当月等于1：返回"January"。
  当月等于2：返回"February"。
  当月等于3：返回"March"。
  当月等于4：返回"April"。
  当月等于5：返回"May"。
  当月等于6：返回"June"。
  当月等于7：返回"July"。
  当月等于8：返回"August"。
  当月等于9：返回"September"。
  当月等于10：返回"October"。
  当月等于11：返回"November"。
  当月等于12：返回"December"。
  返回空。
．

-- 英文星期名称
定英文星期名=函星期：
  当星期等于0：返回"Monday"。
  当星期等于1：返回"Tuesday"。
  当星期等于2：返回"Wednesday"。
  当星期等于3：返回"Thursday"。
  当星期等于4：返回"Friday"。
  当星期等于5：返回"Saturday"。
  当星期等于6：返回"Sunday"。
  返回空。
．

-- 中文月份名称
定中文月名=函月：
  当月等于1：返回"一月"。
  当月等于2：返回"二月"。
  当月等于3：返回"三月"。
  当月等于4：返回"四月"。
  当月等于5：返回"五月"。
  当月等于6：返回"六月"。
  当月等于7：返回"七月"。
  当月等于8：返回"八月"。
  当月等于9：返回"九月"。
  当月等于10：返回"十月"。
  当月等于11：返回"十一月"。
  当月等于12：返回"十二月"。
  返回空。
．

-- 中文星期名称
定中文星期名=函星期：
  当星期等于0：返回"星期一"。
  当星期等于1：返回"星期二"。
  当星期等于2：返回"星期三"。
  当星期等于3：返回"星期四"。
  当星期等于4：返回"星期五"。
  当星期等于5：返回"星期六"。
  当星期等于6：返回"星期日"。
  返回空。
．
