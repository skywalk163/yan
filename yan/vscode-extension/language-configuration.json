{
  "comments": {
    "lineComment": "--"
  },
  "brackets": [
    ["{{", "}}"],
    ["「", "」"],
    ["【", "】"]
  ],
  "autoClosingPairs": [
    {"open": "{{", "close": "}}"},
    {"open": "「", "close": "」"},
    {"open": "【", "close": "】"},
    {"open": "\"", "close": "\"", "notIn": ["string"]}
  ],
  "surroundingPairs": [
    {"open": "{{", "close": "}}"},
    {"open": "「", "close": "」"},
    {"open": "【", "close": "】"},
    {"open": "\"", "close": "\""}
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(定|函|若|遍历|当).*[^。]$",
    "decreaseIndentPattern": "^\\s*。\\s*$"
  },
  "wordBasedSuggestions": true,
  "formattingOptions": {
    "tabSize": 4,
    "insertSpaces": true
  }
}
