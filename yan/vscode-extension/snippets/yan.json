{
  "言语言程序结构": {
    "prefix": "程序",
    "body": [
      "-- ${1:程序名称}",
      "",
      "定 版本 = \"0.1.0\"。",
      "",
      "${2:// 主程序}",
      "",
      "印 \"你好，言语言！\"。"
    ],
    "description": "言语言程序基本结构"
  },
  "定义函数": {
    "prefix": "函",
    "body": [
      "定 ${1:函数名} = 函 ${2:参数}",
      "  ${3:// 函数体}",
      "  ${4:返回}",
      "。"
    ],
    "description": "定义函数"
  },
  "条件语句": {
    "prefix": "若",
    "body": [
      "若 ${1:条件}",
      "  ${2:// 为真时执行}",
      "。",
      "则 ${3:// 否则执行}",
      "。"
    ],
    "description": "条件语句"
  },
  "遍历循环": {
    "prefix": "遍历",
    "body": [
      "遍历 ${1:元素} 于 ${2:列表}",
      "  印 ${1:元素}。",
      "。"
    ],
    "description": "遍历循环"
  },
  "列表操作": {
    "prefix": "列",
    "body": [
      "定 列表 = 列${1:元素1} ${2:元素2} ${3:元素3}。",
      "印 长 列表。"
    ],
    "description": "创建列表"
  },
  "模块导入": {
    "prefix": "引",
    "body": [
      "引 ${1:模块名}。"
    ],
    "description": "导入模块"
  },
  "模块导出": {
    "prefix": "出",
    "body": [
      "出 ${1:导出名称}。"
    ],
    "description": "导出定义"
  },
  "高阶函数-映射": {
    "prefix": "皆",
    "body": [
      "定 结果 = 列1 2 3 皆 乘2。",
      "印 结果。"
    ],
    "description": "使用皆（映射）函数"
  },
  "高阶函数-过滤": {
    "prefix": "只",
    "body": [
      "定 结果 = 列1 2 3 4 5 只 大3。",
      "印 结果。"
    ],
    "description": "使用只（过滤）函数"
  },
  "高阶函数-归约": {
    "prefix": "归",
    "body": [
      "定 结果 = 列1 2 3 4 5 归 加 0。",
      "印 结果。"
    ],
    "description": "使用归（归约）函数"
  },
  "文件读取": {
    "prefix": "读",
    "body": [
      "定 内容 = 读文件 \"${1:文件名}\".",
      "印 内容。"
    ],
    "description": "读取文件"
  },
  "文件写入": {
    "prefix": "写",
    "body": [
      "写文件 \"${1:文件名}\" \"${2:内容}\"。"
    ],
    "description": "写入文件"
  },
  "断言测试": {
    "prefix": "断言",
    "body": [
      "断言等 ${1:实际} ${2:期望}。"
    ],
    "description": "断言相等测试"
  },
  "JSON编码": {
    "prefix": "JSON",
    "body": [
      "定 json串 = 转JSON ${1:对象}。",
      "印 json串。"
    ],
    "description": "JSON编码"
  },
  "JSON解码": {
    "prefix": "解JSON",
    "body": [
      "定 对象 = 解JSON \"${1:json字符串}\"。",
      "印 对象。"
    ],
    "description": "JSON解码"
  }
}
